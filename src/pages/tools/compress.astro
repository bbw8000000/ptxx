---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="图片压缩" description="在线图片压缩工具，浏览器端处理">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="mb-8">
      <a
        href={`${import.meta.env.BASE_URL}tools/`}
        class="text-sm text-accent dark:text-dark-accent hover:underline mb-4 inline-block"
      >
        &larr; 所有工具
      </a>
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">
        TOOLS
      </span>
      <h1 class="font-display text-3xl font-bold text-text dark:text-dark-text">图片压缩</h1>
      <p class="text-text-muted dark:text-dark-text-muted mt-2 font-serif">
        浏览器端处理，图片不上传服务器
      </p>
    </div>

    <div
      id="upload-zone"
      class="border-2 border-dashed border-border/60 dark:border-dark-border/60 rounded-2xl p-12 text-center hover:border-accent dark:hover:border-dark-accent transition-colors cursor-pointer mb-6"
    >
      <svg
        class="w-12 h-12 mx-auto mb-4 text-text-muted dark:text-dark-text-muted"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"
        />
      </svg>
      <p class="text-text-muted dark:text-dark-text-muted mb-2">点击上传或拖拽图片</p>
      <p class="text-xs text-text-muted/60 dark:text-dark-text-muted/60">支持 JPG / PNG / WebP</p>
      <input
        type="file"
        id="file-input"
        accept="image/*"
        style="position:absolute;width:0;height:0;overflow:hidden"
      />
    </div>

    <div id="editor" style="display:none">
      <div class="flex flex-wrap items-center gap-4 mb-6 p-4 bg-surface-alt dark:bg-dark-surface-alt rounded-xl">
        <div class="flex items-center gap-3">
          <label class="text-sm text-text dark:text-dark-text">质量</label>
          <input type="range" id="quality" min="10" max="100" value="80" class="w-32" />
          <span id="quality-val" class="text-sm font-mono text-text dark:text-dark-text w-10">
            80%
          </span>
        </div>
        <div class="flex items-center gap-3">
          <label class="text-sm text-text dark:text-dark-text">格式</label>
          <select
            id="format"
            class="bg-surface dark:bg-dark-surface border border-border/40 dark:border-dark-border/40 rounded-lg px-3 py-1.5 text-sm text-text dark:text-dark-text"
          >
            <option value="image/jpeg">JPG</option>
            <option value="image/png">PNG</option>
            <option value="image/webp">WebP</option>
          </select>
        </div>
        <div class="flex items-center gap-3">
          <label class="text-sm text-text dark:text-dark-text">最大宽度</label>
          <input
            type="number"
            id="max-width"
            value="0"
            min="0"
            class="w-20 bg-surface dark:bg-dark-surface border border-border/40 dark:border-dark-border/40 rounded-lg px-3 py-1.5 text-sm text-text dark:text-dark-text"
            placeholder="0=不变"
          />
          <span class="text-xs text-text-muted dark:text-dark-text-muted">px (0=原始)</span>
        </div>
        <div class="ml-auto flex gap-2">
          <button
            id="btn-switch"
            class="px-3 py-1.5 text-xs font-medium border border-border/60 dark:border-dark-border/60 text-text-muted dark:text-dark-text-muted rounded-md"
          >
            换图
          </button>
          <button
            id="btn-download"
            class="px-4 py-1.5 text-sm font-medium bg-accent dark:bg-dark-accent text-white rounded-md hover:bg-accent-light"
          >
            下载
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-medium text-text dark:text-dark-text">原始</span>
            <span
              id="orig-size"
              class="text-xs font-mono text-text-muted dark:text-dark-text-muted"
            ></span>
          </div>
          <div class="rounded-xl overflow-hidden border border-border/40 dark:border-dark-border/40 bg-surface-alt dark:bg-dark-surface-alt">
            <img id="orig-preview" class="w-full h-auto block" alt="原始图片预览" />
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-medium text-text dark:text-dark-text">压缩后</span>
            <span
              id="comp-size"
              class="text-xs font-mono text-text-muted dark:text-dark-text-muted"
            ></span>
          </div>
          <div class="rounded-xl overflow-hidden border border-border/40 dark:border-dark-border/40 bg-surface-alt dark:bg-dark-surface-alt">
            <canvas id="comp-preview" class="w-full h-auto block"></canvas>
          </div>
        </div>
      </div>
      <div
        id="ratio"
        class="mt-4 text-center text-sm text-accent dark:text-dark-accent font-medium"
      ></div>
    </div>
  </div>

  <script is:inline>
    ;(() => {
      const uploadZone = document.getElementById('upload-zone')
      const fileInput = document.getElementById('file-input')
      const editor = document.getElementById('editor')
      const qualitySlider = document.getElementById('quality')
      const formatSelect = document.getElementById('format')
      const maxWidthInput = document.getElementById('max-width')
      const origPreview = document.getElementById('orig-preview')
      const compPreview = document.getElementById('comp-preview')
      const ctx = compPreview.getContext('2d')

      let originalFile = null
      let img = null
      let loadObjectUrl = null
      let compressionRequest = 0

      uploadZone.addEventListener('click', () => fileInput.click())
      uploadZone.addEventListener('dragover', (e) => {
        e.preventDefault()
        uploadZone.style.borderColor = 'var(--color-accent)'
      })
      uploadZone.addEventListener('dragleave', () => {
        uploadZone.style.borderColor = ''
      })
      uploadZone.addEventListener('drop', (e) => {
        e.preventDefault()
        uploadZone.style.borderColor = ''
        const f = e.dataTransfer.files[0]
        if (f && f.type.startsWith('image/')) loadFile(f)
      })
      fileInput.addEventListener('change', () => {
        if (fileInput.files[0]) loadFile(fileInput.files[0])
      })

      function loadFile(file) {
        compressionRequest += 1
        window._compBlob = null
        if (loadObjectUrl) {
          URL.revokeObjectURL(loadObjectUrl)
          loadObjectUrl = null
        }

        originalFile = file
        document.getElementById('orig-size').textContent = formatSize(file.size)
        const objectUrl = URL.createObjectURL(file)
        loadObjectUrl = objectUrl
        let pendingLoads = 2
        const releaseObjectUrl = () => {
          pendingLoads -= 1
          if (pendingLoads === 0) {
            URL.revokeObjectURL(objectUrl)
            if (loadObjectUrl === objectUrl) loadObjectUrl = null
          }
        }

        origPreview.onload = releaseObjectUrl
        origPreview.onerror = releaseObjectUrl
        origPreview.src = objectUrl
        img = new Image()
        img.onload = () => {
          releaseObjectUrl()
          if (originalFile !== file) return
          uploadZone.style.display = 'none'
          editor.style.display = 'block'
          compress()
        }
        img.onerror = () => {
          releaseObjectUrl()
          if (originalFile !== file) return
          originalFile = null
          img = null
          document.getElementById('ratio').textContent = '图片读取失败'
        }
        img.src = objectUrl
      }

      function compress() {
        if (!img || !originalFile) return
        const sourceFile = originalFile
        const requestId = ++compressionRequest
        const maxW = parseInt(maxWidthInput.value) || 0
        let w = img.naturalWidth
        let h = img.naturalHeight
        if (maxW > 0 && w > maxW) {
          h = Math.round((h * maxW) / w)
          w = maxW
        }
        compPreview.width = w
        compPreview.height = h
        ctx.drawImage(img, 0, 0, w, h)
        const quality = parseInt(qualitySlider.value) / 100
        const format = formatSelect.value
        compPreview.toBlob(
          (blob) => {
            if (requestId !== compressionRequest || sourceFile !== originalFile) return
            if (!blob) {
              window._compBlob = null
              document.getElementById('comp-size').textContent = '-'
              document.getElementById('ratio').textContent = '压缩失败，请更换输出格式后重试'
              return
            }
            document.getElementById('comp-size').textContent = formatSize(blob.size)
            const ratio = Math.round((1 - blob.size / sourceFile.size) * 100)
            document.getElementById('ratio').textContent =
              ratio > 0
                ? `压缩了 ${ratio}%，减小 ${formatSize(sourceFile.size - blob.size)}`
                : `文件变大了 ${Math.abs(ratio)}%`
            window._compBlob = blob
          },
          format,
          quality,
        )
      }

      function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B'
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB'
        return (bytes / 1048576).toFixed(2) + ' MB'
      }

      qualitySlider.addEventListener('input', function () {
        document.getElementById('quality-val').textContent = this.value + '%'
        compress()
      })
      formatSelect.addEventListener('change', compress)
      maxWidthInput.addEventListener('input', compress)

      document.getElementById('btn-download').addEventListener('click', () => {
        if (!window._compBlob) return
        const a = document.createElement('a')
        const ext =
          formatSelect.value.split('/')[1] === 'jpeg' ? 'jpg' : formatSelect.value.split('/')[1]
        const downloadUrl = URL.createObjectURL(window._compBlob)
        a.download = 'compressed.' + ext
        a.href = downloadUrl
        a.click()
        setTimeout(() => URL.revokeObjectURL(downloadUrl), 0)
      })

      document.getElementById('btn-switch').addEventListener('click', () => {
        compressionRequest += 1
        if (loadObjectUrl) {
          URL.revokeObjectURL(loadObjectUrl)
          loadObjectUrl = null
        }
        editor.style.display = 'none'
        uploadZone.style.display = ''
        originalFile = null
        img = null
        window._compBlob = null
        fileInput.value = ''
      })
    })()
  </script>
</BaseLayout>
