---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="密码生成器" description="在线安全密码生成器">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <div class="mb-8">
      <a
        href={`${import.meta.env.BASE_URL}tools/`}
        class="text-sm text-accent dark:text-dark-accent hover:underline mb-4 inline-block"
      >
        &larr; 所有工具
      </a>
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">
        TOOLS
      </span>
      <h1 class="font-display text-3xl font-bold text-text dark:text-dark-text">密码生成器</h1>
      <p class="text-text-muted dark:text-dark-text-muted mt-2 font-serif">生成安全随机密码</p>
    </div>

    <div class="bg-surface-alt dark:bg-dark-surface-alt rounded-xl p-6 mb-6 shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <div
          id="password-display"
          class="flex-1 bg-surface dark:bg-dark-surface rounded-xl px-4 py-3 font-mono text-lg text-text dark:text-dark-text break-all select-all border border-border/40 dark:border-dark-border/40"
        >
          点击生成
        </div>
        <button
          id="btn-copy"
          class="px-4 py-3 bg-accent dark:bg-dark-accent text-white rounded-xl hover:bg-accent-light hover:shadow-md hover:shadow-accent/20 dark:hover:shadow-dark-accent/20 transition-all text-sm font-medium"
        >
          复制
        </button>
      </div>

      <div class="mb-4">
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm text-text dark:text-dark-text">密码长度</label>
          <span id="len-val" class="text-sm font-mono text-accent dark:text-dark-accent">
            16
          </span>
        </div>
        <input type="range" id="length" min="4" max="64" value="16" class="w-full" />
      </div>

      <div class="grid grid-cols-2 gap-3 mb-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="upper" checked class="w-4 h-4 accent-accent" />
          <span class="text-sm text-text dark:text-dark-text">大写字母 A-Z</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="lower" checked class="w-4 h-4 accent-accent" />
          <span class="text-sm text-text dark:text-dark-text">小写字母 a-z</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="digits" checked class="w-4 h-4 accent-accent" />
          <span class="text-sm text-text dark:text-dark-text">数字 0-9</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="symbols" checked class="w-4 h-4 accent-accent" />
          <span class="text-sm text-text dark:text-dark-text">符号 !@#$%</span>
        </label>
      </div>

      <button
        id="btn-gen"
        class="w-full py-3 bg-accent dark:bg-dark-accent text-white rounded-xl hover:bg-accent-light hover:shadow-lg hover:shadow-accent/20 dark:hover:shadow-dark-accent/20 transition-all font-medium"
      >
        生成密码
      </button>
    </div>

    <div class="bg-surface-alt dark:bg-dark-surface-alt rounded-xl p-6 shadow-sm">
      <h3 class="text-sm font-medium text-text dark:text-dark-text mb-3">密码强度</h3>
      <div class="flex gap-1 mb-2" id="strength-bars">
        <div class="h-1.5 flex-1 rounded-full bg-border/30 dark:bg-dark-border/30"></div>
        <div class="h-1.5 flex-1 rounded-full bg-border/30 dark:bg-dark-border/30"></div>
        <div class="h-1.5 flex-1 rounded-full bg-border/30 dark:bg-dark-border/30"></div>
        <div class="h-1.5 flex-1 rounded-full bg-border/30 dark:bg-dark-border/30"></div>
      </div>
      <p id="strength-text" class="text-xs text-text-muted dark:text-dark-text-muted">
        -
      </p>
    </div>
  </div>

  <script is:inline>
    ;(() => {
      const display = document.getElementById('password-display')
      const lengthSlider = document.getElementById('length')
      const lenVal = document.getElementById('len-val')

      const CHARS = {
        upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
        lower: 'abcdefghijklmnopqrstuvwxyz',
        digits: '0123456789',
        symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?',
      }

      function generate() {
        const len = parseInt(lengthSlider.value)
        let chars = ''
        let password = ''

        if (document.getElementById('upper').checked) chars += CHARS.upper
        if (document.getElementById('lower').checked) chars += CHARS.lower
        if (document.getElementById('digits').checked) chars += CHARS.digits
        if (document.getElementById('symbols').checked) chars += CHARS.symbols

        if (!chars) {
          display.textContent = '请至少选择一种字符'
          return
        }

        const arr = new Uint32Array(len)
        crypto.getRandomValues(arr)
        for (let i = 0; i < len; i++) {
          password += chars[arr[i] % chars.length]
        }

        display.textContent = password
        updateStrength(password)
      }

      function updateStrength(pw) {
        let score = 0
        if (pw.length >= 8) score++
        if (pw.length >= 16) score++
        if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++
        if (/[0-9]/.test(pw)) score++
        if (/[^A-Za-z0-9]/.test(pw)) score++
        score = Math.min(4, score)

        const labels = ['弱', '一般', '较强', '强', '非常强']
        const colors = [
          'bg-red-500',
          'bg-orange-500',
          'bg-yellow-500',
          'bg-green-500',
          'bg-emerald-500',
        ]

        const bars = document.getElementById('strength-bars').children
        for (let i = 0; i < 4; i++) {
          bars[i].className =
            'h-1.5 flex-1 rounded-full ' +
            (i < score ? colors[score - 1] : 'bg-border/30 dark:bg-dark-border/30')
        }
        document.getElementById('strength-text').textContent = labels[score - 1] || '请选择字符类型'
      }

      lengthSlider.addEventListener('input', function () {
        lenVal.textContent = this.value
      })

      document.getElementById('btn-gen').addEventListener('click', generate)

      document.getElementById('btn-copy').addEventListener('click', () => {
        const text = display.textContent
        if (text && text !== '点击生成' && text !== '请至少选择一种字符') {
          navigator.clipboard.writeText(text)
          const btn = document.getElementById('btn-copy')
          btn.textContent = '已复制'
          setTimeout(() => {
            btn.textContent = '复制'
          }, 1500)
        }
      })

      generate()
    })()
  </script>
</BaseLayout>
