---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Markdown 预览" description="在线 Markdown 实时预览工具">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="mb-8">
      <a
        href={`${import.meta.env.BASE_URL}tools/`}
        class="text-sm text-accent dark:text-dark-accent hover:underline mb-4 inline-block"
      >
        &larr; 所有工具
      </a>
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">
        TOOLS
      </span>
      <h1 class="font-display text-3xl font-bold text-text dark:text-dark-text">Markdown 预览</h1>
      <p class="text-text-muted dark:text-dark-text-muted mt-2 font-serif">实时渲染 Markdown</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-text dark:text-dark-text mb-2">Markdown</label>
        <textarea
          id="input"
          class="w-full h-[500px] bg-surface-alt dark:bg-dark-surface-alt border border-border/40 dark:border-dark-border/40 rounded-xl p-4 font-mono text-sm text-text dark:text-dark-text resize-y focus:outline-none focus:border-accent dark:focus:border-dark-accent focus:ring-2 focus:ring-accent/10 dark:focus:ring-dark-accent/10 transition-all"
        ># Hello World

这是一段 **Markdown** 文本。

## 列表
- 项目一
- 项目二
- 项目三

## 代码
```js
console.log('Hello!');
```

&gt; 引用文字

[链接](https://example.com)</textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-text dark:text-dark-text mb-2">预览</label>
        <div
          id="preview"
          class="w-full h-[500px] bg-surface dark:bg-dark-surface border border-border/40 dark:border-dark-border/40 rounded-xl p-6 overflow-y-auto prose shadow-sm"
        ></div>
      </div>
    </div>
  </div>

  <script>
    import { marked } from 'marked'
    import { sanitizeHtml } from '../../lib/sanitizeHtml'

    const input = document.getElementById('input') as HTMLTextAreaElement
    const preview = document.getElementById('preview')!

    marked.setOptions({ breaks: true, gfm: true })

    function update() {
      preview.innerHTML = sanitizeHtml(marked.parse(input.value) as string)
    }

    input.addEventListener('input', update)
    update()
  </script>
</BaseLayout>
