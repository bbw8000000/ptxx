---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="404 — 页面未找到"
  description="你要找的页面不存在"
  robots="noindex, nofollow"
  pagefind={false}
>
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
    <!-- 水墨背景装饰 -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.04] dark:opacity-[0.03]">
      <div class="absolute top-1/4 left-1/4 w-64 h-64 rounded-full bg-accent dark:bg-dark-accent blur-[100px]"></div>
      <div class="absolute bottom-1/3 right-1/4 w-48 h-48 rounded-full bg-text dark:bg-dark-text blur-[80px]"></div>
    </div>

    <div class="relative text-center px-6 ink-reveal">
      <!-- 大号 404 -->
      <p class="font-display text-[8rem] md:text-[12rem] font-bold leading-none text-accent/10 dark:text-dark-accent/10 select-none">
        404
      </p>

      <!-- 毛笔图标 -->
      <div class="relative -mt-16 mb-8">
        <svg
          class="w-20 h-20 mx-auto text-accent dark:text-dark-accent opacity-60"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"
          />
        </svg>
      </div>

      <h1 class="font-display text-3xl md:text-4xl font-bold text-text dark:text-dark-text mb-4">
        迷路了
      </h1>
      <p class="text-text-muted dark:text-dark-text-muted mb-3 font-serif text-lg">
        此处空无一物，盤影未落。
      </p>
      <p class="text-sm text-text-muted/60 dark:text-dark-text-muted/60 mb-12">
        页面可能已被移除，或链接有误。
      </p>

      <!-- 返回按钮 -->
      <div class="flex items-center justify-center gap-4">
        <a
          href={`${import.meta.env.BASE_URL}home/`}
          class="magnetic-link inline-flex items-center gap-2 px-7 py-3.5 bg-accent text-white rounded-sm font-medium hover:bg-accent-light transition-all duration-300 hover:shadow-lg hover:shadow-accent/20"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回首页
        </a>
        <a
          href={`${import.meta.env.BASE_URL}blog/`}
          class="magnetic-link inline-flex items-center gap-2 px-7 py-3.5 border border-border dark:border-dark-border text-text dark:text-dark-text rounded-sm font-medium hover:border-accent dark:hover:border-dark-accent hover:text-accent dark:hover:text-dark-accent transition-all duration-300"
        >
          浏览文章
        </a>
      </div>

      <!-- 印章装饰 -->
      <div class="mt-18 flex justify-center">
        <span class="seal text-xs">迷途知返</span>
      </div>
    </div>

    <!-- 底部水墨山 -->
    <div class="ink-mountain"></div>
  </section>
</BaseLayout>
