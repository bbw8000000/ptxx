---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import Sidebar from '../../components/Sidebar.astro'
import { getCollection } from 'astro:content'
import { calcReadingTime } from '../../utils/readingTime'

const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.noindex)
const sortedPosts = [...allPosts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const categories = [...new Set(allPosts.map((p) => p.data.category))].map((name) => ({
  name,
  count: allPosts.filter((p) => p.data.category === name).length,
}))
const sidebarPosts = sortedPosts.slice(0, 5).map((p) => ({
  title: p.data.title,
  slug: p.id,
  pubDate: p.data.pubDate,
}))

const groupedByCategory = sortedPosts.reduce(
  (acc, post) => {
    const cat = post.data.category
    return {
      ...acc,
      [cat]: [...(acc[cat] || []), post],
    }
  },
  {} as Record<string, typeof sortedPosts>,
)

const categoryOrder = ['成长记录', '技术']
const sortedCategories = categoryOrder.filter((c) => groupedByCategory[c])
const allCategories = [
  ...sortedCategories,
  ...Object.keys(groupedByCategory).filter((c) => !categoryOrder.includes(c)),
]
const totalTags = new Set(allPosts.flatMap((p) => p.data.tags)).size
const latestPost = sortedPosts[0]
const categoryAnchor = (category: string) =>
  `category-${encodeURIComponent(category).replace(/%/g, '').toLowerCase()}`

const categoryIcons: Record<string, string> = {
  成长记录: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
  技术: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
}
---

<BaseLayout title="文章" description="所有文章列表">
  <div class="blog-index-page">
    <div class="blog-index-orbit blog-index-orbit--cold"></div>
    <div class="blog-index-orbit blog-index-orbit--warm"></div>
    <section class="blog-hero ink-reveal" aria-labelledby="blog-heading">
      <div class="blog-hero-copy">
        <div class="blog-kicker-row">
          <span class="blog-kicker-line"></span>
          <p class="blog-kicker">Archive / Field notes / Experiments</p>
        </div>
        <h1 id="blog-heading" class="blog-title">
          所有文章
        </h1>
        <p class="blog-subtitle">
          把 AI 工具实测、踩坑记录和阶段复盘收进同一个暗色索引里，方便你按主题快速翻到有用的东西。
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a
            href={`${import.meta.env.BASE_URL}archive/`}
            class="inline-flex items-center gap-1.5 text-xs text-text-secondary hover:text-accent transition-colors font-sans"
          >
            归档
          </a>
          <span class="text-text-muted/40">·</span>
          <a
            href={`${import.meta.env.BASE_URL}tags/`}
            class="inline-flex items-center gap-1.5 text-xs text-text-secondary hover:text-accent transition-colors font-sans"
          >
            标签
          </a>
          <span class="text-text-muted/40">·</span>
          <a
            href={`${import.meta.env.BASE_URL}github-daily/`}
            class="inline-flex items-center gap-1.5 text-xs text-text-secondary hover:text-accent transition-colors font-sans"
          >
            GitHub 日报
          </a>
        </div>
      </div>
      <div class="blog-hero-panel" aria-label="文章统计">
        <span class="blog-panel-label">Current archive</span>
        <div class="blog-panel-grid">
          <div>
            <strong>{sortedPosts.length}</strong>
            <span>篇文章</span>
          </div>
          <div>
            <strong>{allCategories.length}</strong>
            <span>个分类</span>
          </div>
          <div>
            <strong>{totalTags}</strong>
            <span>个标签</span>
          </div>
        </div>
        {latestPost && (
          <a href={`${import.meta.env.BASE_URL}blog/${latestPost.id}/`} class="blog-latest-link">
            <span>最新</span>
            <strong>{latestPost.data.title}</strong>
          </a>
        )}
      </div>
    </section>

    <section class="blog-controls ink-reveal ink-reveal-delay-1" aria-label="文章搜索和分类筛选">
      <div class="blog-search-wrap">
        <svg
          class="blog-search-icon"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        <input
          type="text"
          id="search-input"
          class="blog-search-input"
          placeholder="搜索文章标题、描述、分类、标签..."
          aria-label="搜索文章"
        />
        <button
          type="button"
          id="search-clear"
          class="blog-search-clear"
          aria-label="清空搜索"
          hidden
        >
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="blog-filter-row" aria-label="文章分类导航">
        <a
          href="#posts-grid"
          class="blog-filter-chip blog-filter-chip--active"
          data-filter-chip="all"
          aria-current="true"
        >
          全部
        </a>
        {allCategories.map((cat) => (
          <a href={`#${categoryAnchor(cat)}`} class="blog-filter-chip" data-filter-chip={cat}>
            {cat}
            <span>{groupedByCategory[cat].length}</span>
          </a>
        ))}
      </div>
      <p id="search-count" class="blog-search-count hidden" role="status" aria-live="polite"></p>
    </section>

    <section class="blog-content-shell">
      <div class="blog-content-main">
        <div id="posts-grid">
          {allCategories.map((cat) => (
            <section id={categoryAnchor(cat)} class="blog-category-section" data-category={cat}>
              <div class="blog-category-header ink-reveal" data-category-header={cat}>
                <span
                  class="blog-category-icon"
                  set:html={categoryIcons[cat] || categoryIcons['技术']}
                />
                <div>
                  <h2>{cat}</h2>
                  <p>
                    {cat === '成长记录'
                      ? '真实状态、学习路径和阶段复盘。'
                      : '工具、代码、技术趋势和可复用经验。'}
                  </p>
                </div>
                <span
                  class="blog-category-count"
                  data-original-count={groupedByCategory[cat].length}
                >
                  {groupedByCategory[cat].length} 篇
                </span>
              </div>
              <div class="blog-post-grid">
                {groupedByCategory[cat].map((post, i) => (
                  <div
                    class:list={['blog-post-item', 'ink-reveal', `ink-reveal-delay-${(i % 4) + 1}`]}
                    data-title={post.data.title.toLowerCase()}
                    data-desc={post.data.description.toLowerCase()}
                    data-category={post.data.category.toLowerCase()}
                    data-tags={post.data.tags.join(',').toLowerCase()}
                  >
                    <PostCard
                      title={post.data.title}
                      description={post.data.description}
                      pubDate={post.data.pubDate}
                      tags={post.data.tags}
                      category={post.data.category}
                      slug={post.id}
                      readingTime={calcReadingTime(post.body || '')}
                    />
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div id="blog-no-results" class="blog-no-results hidden" aria-hidden="true">
          <span>Nothing matched</span>
          <strong>没找到相关文章</strong>
          <p>换个关键词，或者清空搜索回到完整档案。</p>
          <button type="button" id="no-results-clear" class="blog-no-results-clear">
            清空搜索
          </button>
        </div>

        {sortedPosts.length === 0 && (
          <div class="blog-empty">
            <p>暂无文章</p>
          </div>
        )}
      </div>

      <aside class="blog-sidebar-wrap ink-reveal ink-reveal-delay-2">
        <Sidebar categories={categories} recentPosts={sidebarPosts} />
      </aside>
    </section>
  </div>

  <script is:inline>
    const BLOG_INDEX_LIFECYCLE_KEY = '__blogIndexLifecycleBound'
    const BLOG_INDEX_TEARDOWN_KEY = '__blogIndexTeardown'

    window[BLOG_INDEX_TEARDOWN_KEY] = window[BLOG_INDEX_TEARDOWN_KEY] || (() => {})

    const teardownBlogIndex = () => {
      window[BLOG_INDEX_TEARDOWN_KEY]()
      window[BLOG_INDEX_TEARDOWN_KEY] = () => {}
    }

    const initBlogIndex = () => {
      teardownBlogIndex()

      const searchInput = document.getElementById('search-input')
      const searchClear = document.getElementById('search-clear')
      const postsGrid = document.getElementById('posts-grid')
      const searchCount = document.getElementById('search-count')
      const noResults = document.getElementById('blog-no-results')
      const noResultsClear = document.getElementById('no-results-clear')
      const heroPanel = document.querySelector('.blog-hero-panel')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (!searchInput || !postsGrid) return

      let observer
      let spotlightFrame = 0
      let pendingPointerEvent
      let heroPanelRect
      let activeScrollFrame = 0

      const filterChips = document.querySelectorAll('[data-filter-chip]')
      const setActiveChip = (activeCategory) => {
        filterChips.forEach((chip) => {
          const isActive = chip.dataset.filterChip === activeCategory
          chip.classList.toggle('blog-filter-chip--active', isActive)
          if (isActive) {
            chip.setAttribute('aria-current', 'true')
          } else {
            chip.removeAttribute('aria-current')
          }
        })
      }

      const updateSearch = () => {
        const query = searchInput.value.trim().toLowerCase()
        const sections = postsGrid.querySelectorAll('.blog-category-section')
        let totalVisible = 0

        sections.forEach((section) => {
          const cards = section.querySelectorAll('[data-title]')
          let sectionVisible = 0

          cards.forEach((card) => {
            const title = card.dataset.title || ''
            const desc = card.dataset.desc || ''
            const category = card.dataset.category || ''
            const tags = card.dataset.tags || ''
            const match =
              !query ||
              title.includes(query) ||
              desc.includes(query) ||
              category.includes(query) ||
              tags.includes(query)
            card.classList.toggle('is-search-hidden', !match)
            card.setAttribute('aria-hidden', match ? 'false' : 'true')
            if (match) sectionVisible++
          })

          section.classList.toggle('is-section-hidden', Boolean(query && sectionVisible === 0))

          const countEl = section.querySelector('.blog-category-count')
          if (countEl) {
            const originalCount = countEl.dataset.originalCount || sectionVisible
            countEl.textContent = `${query ? sectionVisible : originalCount} 篇`
            countEl.classList.toggle('is-count-updated', Boolean(query))
          }

          totalVisible += sectionVisible
        })

        if (searchClear) searchClear.hidden = !query

        if (query && searchCount) {
          searchCount.textContent = `找到 ${totalVisible} 篇文章`
          searchCount.classList.remove('hidden', 'is-visually-hidden')
        } else if (searchCount) {
          searchCount.textContent = `已显示全部 ${totalVisible} 篇文章`
          searchCount.classList.add('is-visually-hidden')
          searchCount.classList.remove('hidden')
        }

        if (noResults) {
          noResults.classList.toggle('hidden', !query || totalVisible > 0)
          noResults.setAttribute('aria-hidden', !query || totalVisible > 0 ? 'true' : 'false')
        }
      }

      const clearSearch = () => {
        searchInput.value = ''
        searchInput.focus()
        updateSearch()
      }

      const updateSpotlight = () => {
        spotlightFrame = 0
        if (!heroPanel || !pendingPointerEvent) return
        heroPanelRect = heroPanelRect || heroPanel.getBoundingClientRect()

        const x = ((pendingPointerEvent.clientX - heroPanelRect.left) / heroPanelRect.width) * 100
        const y = ((pendingPointerEvent.clientY - heroPanelRect.top) / heroPanelRect.height) * 100
        heroPanel.style.setProperty('--hero-x', `${x}%`)
        heroPanel.style.setProperty('--hero-y', `${y}%`)
      }

      const moveSpotlight = (event) => {
        pendingPointerEvent = event
        if (!spotlightFrame) spotlightFrame = requestAnimationFrame(updateSpotlight)
      }

      const cacheHeroPanelRect = () => {
        heroPanelRect = heroPanel?.getBoundingClientRect()
      }

      searchInput.addEventListener('input', updateSearch)
      searchClear?.addEventListener('click', clearSearch)
      noResultsClear?.addEventListener('click', clearSearch)

      if (heroPanel && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
        heroPanel.addEventListener('pointerenter', cacheHeroPanelRect)
        heroPanel.addEventListener('pointermove', moveSpotlight)
        window.addEventListener('resize', cacheHeroPanelRect)
      }

      const categorySections = postsGrid.querySelectorAll('.blog-category-section')
      const updateActiveCategory = () => {
        activeScrollFrame = 0

        if (window.scrollY < postsGrid.offsetTop - 160) {
          setActiveChip('all')
          return
        }

        const activeSection = [...categorySections]
          .map((section) => ({
            section,
            distance: Math.abs(section.getBoundingClientRect().top - 150),
          }))
          .sort((a, b) => a.distance - b.distance)[0]?.section

        if (activeSection) setActiveChip(activeSection.dataset.category)
      }

      const scheduleActiveCategory = () => {
        if (!activeScrollFrame) activeScrollFrame = requestAnimationFrame(updateActiveCategory)
      }

      window.addEventListener('scroll', scheduleActiveCategory, { passive: true })
      updateActiveCategory()

      if ('IntersectionObserver' in window && categorySections.length && filterChips.length) {
        observer = new IntersectionObserver(scheduleActiveCategory, {
          rootMargin: '-18% 0px -62% 0px',
          threshold: [0.15, 0.35, 0.6],
        })

        categorySections.forEach((section) => observer.observe(section))
      }

      window[BLOG_INDEX_TEARDOWN_KEY] = () => {
        searchInput.removeEventListener('input', updateSearch)
        searchClear?.removeEventListener('click', clearSearch)
        noResultsClear?.removeEventListener('click', clearSearch)
        heroPanel?.removeEventListener('pointerenter', cacheHeroPanelRect)
        heroPanel?.removeEventListener('pointermove', moveSpotlight)
        window.removeEventListener('resize', cacheHeroPanelRect)
        window.removeEventListener('scroll', scheduleActiveCategory)
        if (spotlightFrame) cancelAnimationFrame(spotlightFrame)
        if (activeScrollFrame) cancelAnimationFrame(activeScrollFrame)
        observer?.disconnect()
      }
    }

    if (!window[BLOG_INDEX_LIFECYCLE_KEY]) {
      document.addEventListener('astro:before-swap', teardownBlogIndex)
      document.addEventListener('astro:page-load', initBlogIndex)
      window[BLOG_INDEX_LIFECYCLE_KEY] = true
    }

    initBlogIndex()
  </script>
  <style>
    .blog-index-page {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      max-width: 1280px;
      margin: 0 auto;
      padding: 5rem 2rem 6rem;
    }

    .blog-index-page::before {
      content: '';
      position: absolute;
      inset: 6rem 0 auto;
      z-index: -2;
      height: 42rem;
      background:
        radial-gradient(ellipse 34% 48% at 18% 8%, rgba(122, 149, 175, 0.16), transparent 70%),
        radial-gradient(ellipse 26% 38% at 84% 20%, rgba(200, 182, 142, 0.08), transparent 72%);
      pointer-events: none;
    }

    .blog-index-page::after {
      content: '';
      position: absolute;
      left: 2rem;
      top: 9rem;
      bottom: 5rem;
      z-index: -1;
      width: 1px;
      background: linear-gradient(
        180deg,
        transparent,
        rgba(122, 149, 175, 0.2),
        rgba(200, 182, 142, 0.12),
        transparent
      );
      pointer-events: none;
    }

    .blog-index-orbit {
      position: absolute;
      z-index: -1;
      border: 1px solid rgba(122, 149, 175, 0.08);
      border-radius: 999px;
      pointer-events: none;
    }

    .blog-index-orbit--cold {
      top: 7rem;
      right: -10rem;
      width: 26rem;
      height: 26rem;
      box-shadow: inset 0 0 80px rgba(122, 149, 175, 0.035);
    }

    .blog-index-orbit--warm {
      top: 26rem;
      left: -9rem;
      width: 18rem;
      height: 18rem;
      border-color: rgba(200, 182, 142, 0.07);
    }

    .blog-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: end;
      margin-bottom: 2rem;
    }

    .blog-kicker-row {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 1.1rem;
    }

    .blog-kicker-line {
      width: 3rem;
      height: 1px;
      background: linear-gradient(90deg, rgba(122, 149, 175, 0.55), transparent);
    }

    .blog-kicker {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(122, 149, 175, 0.78);
    }

    .blog-title {
      position: relative;
      font-family: var(--font-display);
      font-size: clamp(3.2rem, 8vw, 6.2rem);
      font-weight: 800;
      line-height: 0.96;
      letter-spacing: 0.025em;
      color: var(--color-text);
      margin-bottom: 1.25rem;
    }

    .blog-title::after {
      content: '';
      position: absolute;
      left: 0.1em;
      bottom: 0.08em;
      width: min(11rem, 42vw);
      height: 1px;
      background: linear-gradient(90deg, rgba(200, 182, 142, 0.5), transparent);
      box-shadow: 0 0 20px rgba(200, 182, 142, 0.1);
    }

    .blog-subtitle {
      max-width: 34rem;
      font-family: var(--font-serif);
      font-size: clamp(1rem, 1.6vw, 1.12rem);
      line-height: 1.9;
      color: rgba(214, 218, 225, 0.72);
    }

    .blog-hero-panel {
      --hero-x: 22%;
      --hero-y: 18%;
      position: relative;
      overflow: hidden;
      padding: 1.5rem;
      border: 1px solid var(--border-glass-strong);
      border-radius: 1.5rem;
      background:
        linear-gradient(145deg, rgba(32, 45, 68, 0.62), rgba(6, 10, 18, 0.36)),
        radial-gradient(circle at 18% 0%, rgba(226, 238, 248, 0.16), transparent 46%),
        radial-gradient(circle at 100% 100%, rgba(200, 142, 82, 0.12), transparent 44%);
      backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
      -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
      box-shadow: var(--shadow-glass-strong);
      transition:
        border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .blog-hero-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(
          circle at var(--hero-x) var(--hero-y),
          rgba(200, 182, 142, 0.16),
          transparent 24%
        ),
        linear-gradient(
          115deg,
          transparent 0 38%,
          rgba(226, 238, 248, 0.11) 44%,
          rgba(122, 149, 175, 0.07) 50%,
          transparent 62%
        );
      opacity: 0.92;
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .blog-hero-panel:hover {
      transform: translateY(-3px);
      border-color: var(--border-warm);
      box-shadow:
        0 38px 100px rgba(0, 0, 0, 0.6),
        var(--glow-warm),
        var(--glass-rim-strong);
    }

    .blog-hero-panel > * {
      position: relative;
      z-index: 1;
    }

    .blog-hero-panel::after {
      content: '';
      position: absolute;
      z-index: 0;
      right: -4rem;
      bottom: -4rem;
      width: 10rem;
      height: 10rem;
      border: 1px solid rgba(200, 182, 142, 0.08);
      border-radius: 999px;
    }

    .blog-panel-label {
      display: block;
      margin-bottom: 1rem;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(200, 182, 142, 0.7);
    }

    .blog-panel-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
      margin-bottom: 1.15rem;
    }

    .blog-panel-grid div {
      padding: 0.8rem 0.65rem;
      border: 1px solid rgba(226, 238, 248, 0.11);
      border-radius: 0.95rem;
      background:
        linear-gradient(145deg, rgba(122, 149, 175, 0.1), rgba(6, 10, 18, 0.18)),
        radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.08), transparent 62%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 10px 26px rgba(0, 0, 0, 0.2);
    }

    .blog-panel-grid strong,
    .blog-panel-grid span {
      display: block;
    }

    .blog-panel-grid strong {
      font-family: var(--font-display);
      font-size: 1.35rem;
      color: var(--color-text);
      line-height: 1;
    }

    .blog-panel-grid span {
      margin-top: 0.45rem;
      font-size: 0.68rem;
      color: rgba(168, 175, 186, 0.64);
    }

    .blog-latest-link {
      position: relative;
      display: block;
      padding: 1rem;
      border: 1px solid rgba(226, 238, 248, 0.12);
      border-radius: 1rem;
      text-decoration: none;
      background:
        linear-gradient(135deg, rgba(122, 149, 175, 0.11), rgba(200, 142, 82, 0.045)),
        rgba(6, 10, 18, 0.2);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
      transition:
        border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        background 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .blog-latest-link span {
      display: block;
      margin-bottom: 0.45rem;
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      color: rgba(122, 149, 175, 0.78);
      text-transform: uppercase;
    }

    .blog-latest-link strong {
      display: block;
      color: rgba(250, 250, 249, 0.86);
      font-family: var(--font-serif);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .blog-latest-link:hover,
    .blog-latest-link:focus-visible {
      transform: translateY(-2px);
