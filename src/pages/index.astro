---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.noindex)
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const latestPost = sortedPosts[0]
---

<BaseLayout title="盘腿修仙 - Entrance">
  <!-- WebP 优先：同一张图 124KB vs JPEG 193KB。旧浏览器走后面的 jpg 回退。 -->
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href={`${import.meta.env.BASE_URL}maple.webp`}
  />
  <div class="entrance-container" id="entrance-root">
    <div class="bg-layer">
      <video
        id="entrance-video"
        class="bg-media"
        preload="none"
        loop
        muted
        playsinline
        data-src={`${import.meta.env.BASE_URL}maple.mp4`}
        poster={`${import.meta.env.BASE_URL}maple.webp`}
      ></video>
    </div>

    <canvas id="particle-canvas" class="particle-canvas" aria-hidden="true"></canvas>

    <div class="fog-veil" aria-hidden="true"></div>

    <div class="entrance-scene" aria-hidden="true">
      <span class="entrance-orbit entrance-orbit--cold"></span>
      <span class="entrance-orbit entrance-orbit--warm"></span>
      <span class="entrance-spine"></span>
      <span class="entrance-corner-light"></span>
    </div>

    <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

    <div class="content-layer">
      <div class="ink-blooms" aria-hidden="true">
        <span class="ink-bloom ink-bloom--a"></span>
        <span class="ink-bloom ink-bloom--b"></span>
      </div>

      <div class="maple-boot-icon" aria-hidden="true">
        <svg class="maple-glyph" viewBox="0 0 128 128" focusable="false">
          <defs>
            <linearGradient
              id="mapleGlass"
              x1="24"
              y1="10"
              x2="104"
              y2="118"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color="rgb(255,255,255)" stop-opacity="0.96" />
              <stop offset="0.38" stop-color="rgb(226,238,248)" stop-opacity="0.76" />
              <stop offset="1" stop-color="rgb(178,84,54)" stop-opacity="0.26" />
            </linearGradient>
          </defs>
          <path d="M64 13 C68 30 75 43 84 53 C91 46 99 41 108 38 C106 50 101 62 93 72 C102 73 111 76 119 82 C109 88 98 91 86 91 C89 101 89 111 86 119 C77 113 70 105 64 95 C58 105 51 113 42 119 C39 111 39 101 42 91 C30 91 19 88 9 82 C17 76 26 73 35 72 C27 62 22 50 20 38 C29 41 37 46 44 53 C53 43 60 30 64 13 Z" />
          <path
            class="maple-vein"
            d="M64 28 C64 50 64 75 64 109 M64 68 C56 61 49 55 42 50 M64 68 C72 61 79 55 86 50"
          />
        </svg>
      </div>

      <h1 class="editorial-title" aria-label="盘腿修仙">
        <span class="editorial-line" aria-hidden="true"></span>
        <span class="handwriting-title" aria-hidden="true">
          <span class="handwriting-word">
            <span class="handwriting-char handwriting-char--ink">
              <span class="handwriting-piece handwriting-piece--mo-1" style="--delay:3.48s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-2" style="--delay:3.60s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-3" style="--delay:3.72s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-4" style="--delay:3.84s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-5" style="--delay:3.96s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-6" style="--delay:4.08s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-7" style="--delay:4.20s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-8" style="--delay:4.32s">
                盤
              </span>
              <span class="handwriting-piece handwriting-piece--mo-9" style="--delay:4.44s">
                盤
              </span>
            </span>
          </span>
        </span>
        <span class="editorial-chars">
          <span
            class="editorial-char editorial-char--ink"
            style="--glyph-delay: 3.88s; --bloom-delay: 3.78s; --trace-delay: 4.14s; --drift-delay: 5.8s"
            data-depth="0.7"
          >
            盤
          </span>
        </span>
      </h1>
      <p class="blur-reveal subtitle" id="entrance-subtitle">
        一个安静记录生活和想法的角落
      </p>

      <a
        href={`${import.meta.env.BASE_URL}home/`}
        class="blur-reveal enter-btn"
        id="enter-btn"
        aria-describedby="entrance-subtitle"
      >
        <span class="btn-glass-overlay" aria-hidden="true"></span>
        <span class="btn-text">进入盘腿修仙</span>
      </a>

      <a
        class="blur-reveal atmosphere-btn"
        id="entrance-playlist"
        href="https://music.163.com/#/playlist?id=2931801429"
        target="_blank"
        rel="noopener noreferrer"
      >
        我的歌单
      </a>

      {latestPost && (
        <a class="recent-update" href={`${import.meta.env.BASE_URL}blog/${latestPost.id}/`}>
          <span>最近更新：</span>
          <span>
            {latestPost.data.pubDate.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })}{' '}
            · {latestPost.data.title}
          </span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <div class="bottom-quote" id="bottom-quote">
      <p class="quote-text" id="quote-text"></p>
      <p class="quote-author" id="quote-author"></p>
    </div>
  </div>

  <script is:inline>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const saveData = navigator.connection?.saveData === true
    const isMobileDevice = window.matchMedia('(max-width: 768px)').matches
    const staticMedia = reduceMotion || saveData || isMobileDevice

    {
      // === time-based color temperature ===
      const hour = new Date().getHours()
      const phase =
        hour < 6
          ? 'night'
          : hour < 12
            ? 'morning'
            : hour < 18
              ? 'afternoon'
              : hour < 22
                ? 'evening'
                : 'night'
      document.documentElement.setAttribute('data-time', phase)
    } // end time block

    {
      // === video autoplay ===
      const ev = document.getElementById('entrance-video')
      if (ev && !staticMedia) {
        const videoSrc = ev.dataset.src
        if (videoSrc && !ev.src) {
          ev.src = videoSrc
          ev.load()
        }

        const playVideo = () => {
          if (!document.hidden) ev.play().catch(() => {})
        }
        playVideo()
        const resumeVideo = () => {
          ev.play().catch(() => {})
        }
        const syncVideoVisibility = () => {
          if (document.hidden) ev.pause()
          else playVideo()
        }
        document.addEventListener('click', resumeVideo, { once: true })
        document.addEventListener('visibilitychange', syncVideoVisibility)
        document.addEventListener(
          'astro:before-swap',
          () => {
            document.removeEventListener('click', resumeVideo)
            document.removeEventListener('visibilitychange', syncVideoVisibility)
            ev.pause()
          },
          { once: true },
        )
      }
    } // end video block

    {
      // === particle system — fireflies + maple leaves ===
      const canvas = document.getElementById('particle-canvas')
      if (canvas && !staticMedia) {
        const ctx = canvas.getContext('2d')
        let W = 0,
          H = 0,
          animId = 0
        let particlesRunning = false
        const fireflies = []
        const leaves = []

        function resize() {
          const rect = canvas.parentElement.getBoundingClientRect()
          W = canvas.width = rect.width
          H = canvas.height = rect.height
        }

        class Firefly {
          constructor() {
            this.reset(true)
          }
          reset(init) {
            this.x = Math.random() * W
            this.y = init ? Math.random() * H : H + 30
            this.size = 0.8 + Math.random() * 1.5
            this.glow = 8 + Math.random() * 14
            this.speed = 0.15 + Math.random() * 0.35
            this.drift = (Math.random() - 0.5) * 0.35
            this.phase = Math.random() * Math.PI * 2
            this.pulse = 0.01 + Math.random() * 0.02
            this.alpha = 0
            this.vx = 0
            this.vy = 0
          }
          update() {
            if (this.vx || this.vy) {
              this.x += this.vx
              this.y += this.vy
              this.vx *= 0.98
              this.vy *= 0.98
              this.alpha *= 0.97
              return
            }
            const dx = this.x - mouseX
            const dy = this.y - mouseY
            const dist = Math.sqrt(dx * dx + dy * dy)
            if (dist < 80 && dist > 0) {
              this.x += (dx / dist) * 0.6
              this.y += (dy / dist) * 0.6
            }
            this.y -= this.speed
            this.x += Math.sin(this.phase) * this.drift
            this.phase += 0.01
            this.alpha = 0.04 + Math.sin(Date.now() * this.pulse + this.phase) * 0.08
            if (this.y < -40) this.reset(false)
          }
          draw() {
            const g = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.glow)
            g.addColorStop(0, `rgba(220,200,150,${(this.alpha * 0.7).toFixed(2)})`)
            g.addColorStop(0.3, `rgba(200,170,120,${(this.alpha * 0.35).toFixed(2)})`)
            g.addColorStop(0.7, `rgba(160,130,80,${(this.alpha * 0.05).toFixed(2)})`)
            g.addColorStop(1, 'rgba(160,130,80,0)')
            ctx.fillStyle = g
            ctx.beginPath()
            ctx.arc(this.x, this.y, this.glow, 0, Math.PI * 2)
            ctx.fill()
            ctx.fillStyle = `rgba(230,215,180,${(this.alpha * 1.1).toFixed(2)})`
            ctx.beginPath()
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2)
            ctx.fill()
          }
        }

        class MapleLeaf {
          constructor() {
            this.reset(true)
          }
          reset(init) {
            this.x = Math.random() * W * 1.2 - W * 0.1
            this.y = init ? Math.random() * H * -0.5 : -30
            this.size = 6 + Math.random() * 12
            this.speed = 0.3 + Math.random() * 0.9
            this.sway = (Math.random() - 0.5) * 1.4
            this.phase = Math.random() * Math.PI * 2
            this.rot = Math.random() * Math.PI * 2
            this.rotSpeed = (Math.random() - 0.5) * 0.02
            this.alpha = 0.15 + Math.random() * 0.35
            this.vx = 0
            this.vy = 0
          }
          update() {
            if (this.vx || this.vy) {
              this.x += this.vx
              this.y += this.vy
              this.vx *= 0.98
              this.vy *= 0.98
              this.alpha *= 0.97
              this.rot += this.rotSpeed * 3
              return
            }
            this.y += this.speed
            this.x += Math.sin(this.phase) * this.sway
            this.phase += 0.015
            this.rot += this.rotSpeed
            if (this.y > H + 40) this.reset(false)
          }
          draw() {
            ctx.save()
            ctx.translate(this.x, this.y)
            ctx.rotate(this.rot)
            ctx.globalAlpha = this.alpha
            const s = this.size
            ctx.fillStyle = '#4a2020'
            ctx.beginPath()
            ctx.moveTo(0, -s)
            ctx.bezierCurveTo(s * 0.7, -s * 0.6, s * 0.8, s * 0.3, 0, s)
            ctx.bezierCurveTo(-s * 0.8, s * 0.3, -s * 0.7, -s * 0.6, 0, -s)
            ctx.fill()
            ctx.strokeStyle = 'rgba(120,60,40,0.3)'
            ctx.lineWidth = 0.5
            ctx.beginPath()
            ctx.moveTo(0, -s)
            ctx.lineTo(0, s)
            ctx.stroke()
            ctx.restore()
          }
        }

        const isMobile = window.matchMedia('(max-width: 768px)').matches
        const ffCount = isMobile ? 3 : 8
        const leafCount = isMobile ? 2 : 7
        for (let i = 0; i < ffCount; i++) fireflies.push(new Firefly())
        for (let i = 0; i < leafCount; i++) leaves.push(new MapleLeaf())
        window.__particles = { fireflies, leaves, W: () => W, H: () => H }

        let mouseX = -999,
          mouseY = -999
        let canvasRect = canvas.getBoundingClientRect()
        let parallaxPending = false

        const updateCanvasRect = () => {
          canvasRect = canvas.getBoundingClientRect()
        }

        const titleChars = document.querySelectorAll('.editorial-char')
        const onMouseMove = (e) => {
          mouseX = e.clientX - canvasRect.left
          mouseY = e.clientY - canvasRect.top
          if (!parallaxPending) {
            parallaxPending = true
            requestAnimationFrame(() => {
              const bgMedia = document.querySelector('.bg-media')
              if (bgMedia) {
                const px = (e.clientX / window.innerWidth - 0.5) * -12
                const py = (e.clientY / window.innerHeight - 0.5) * -12
                bgMedia.style.transform = `translate(${px.toFixed(1)}px, ${py.toFixed(1)}px) scale(1.04)`
              }
              const gl = document.getElementById('cursor-glow')
              if (gl) {
                gl.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`
                gl.style.opacity = '1'
              }
              titleChars.forEach((el) => {
                const depth = parseFloat(el.getAttribute('data-depth')) || 0
                const dx = (e.clientX / window.innerWidth - 0.5) * -28 * depth
                const dy = (e.clientY / window.innerHeight - 0.5) * -20 * depth
                el.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`
                el.style.transition = 'none'
              })
              parallaxPending = false
            })
          }
        }
        const onMouseLeave = () => {
          mouseX = -999
          mouseY = -999
          const gl = document.getElementById('cursor-glow')
          if (gl) gl.style.opacity = '0'
          titleChars.forEach((el) => {
            el.style.transform = 'translate3d(0, 0, 0)'
            el.style.transition = 'transform 0.9s cubic-bezier(0.16, 1, 0.3, 1)'
          })
        }

        document.addEventListener('mousemove', onMouseMove, { passive: true })
        document.addEventListener('mouseleave', onMouseLeave)

        function animate() {
          if (!particlesRunning) return
          ctx.clearRect(0, 0, W, H)
          fireflies.forEach((f) => {
            f.update()
            f.draw()
          })
          leaves.forEach((l) => {
            l.update()
            l.draw()
          })
          animId = requestAnimationFrame(animate)
        }

        const startParticles = () => {
          if (particlesRunning || document.hidden) return
          particlesRunning = true
          animate()
        }

        const stopParticles = () => {
          particlesRunning = false
          cancelAnimationFrame(animId)
          animId = 0
        }

        const syncParticleVisibility = () => {
          if (document.hidden) stopParticles()
          else startParticles()
        }

        const onResize = () => {
          resize()
          updateCanvasRect()
        }
        window.addEventListener('resize', onResize, { passive: true })
        document.addEventListener('visibilitychange', syncParticleVisibility)
        resize()
        startParticles()

        document.addEventListener(
          'astro:before-swap',
          () => {
            stopParticles()
            window.removeEventListener('resize', onResize)
            document.removeEventListener('visibilitychange', syncParticleVisibility)
            document.removeEventListener('mousemove', onMouseMove)
            document.removeEventListener('mouseleave', onMouseLeave)
          },
          { once: true },
        )
      }
    } // end particle block

    {
      // === random quote ===
      const quotes = [
        { text: '山不让尘，川不辞盈。', author: '张华' },
        { text: '身在无间，心在桃源。', author: '墨香铜臭' },
        { text: '明月松间照，清泉石上流。', author: '王维' },
        { text: '行到水穷处，坐看云起时。', author: '王维' },
        { text: '空山不见人，但闻人语响。', author: '王维' },
        { text: '晚来天欲雪，能饮一杯无？', author: '白居易' },
        { text: '浮生若梦，为欢几何。', author: '李白' },
        { text: '此心安处是吾乡。', author: '苏轼' },
        { text: '人生如逆旅，我亦是行人。', author: '苏轼' },
        { text: '醉后不知天在水，满船清梦压星河。', author: '唐温如' },
        { text: '山中何事？松花酿酒，春水煎茶。', author: '张可久' },
        { text: '且将新火试新茶，诗酒趁年华。', author: '苏轼' },
        { text: '我见青山多妩媚，料青山见我应如是。', author: '辛弃疾' },
        { text: '欲买桂花同载酒，终不似，少年游。', author: '刘过' },
      ]
      const q = quotes[Math.floor(Math.random() * quotes.length)]
      const tel = document.getElementById('quote-text')
      const ael = document.getElementById('quote-author')
      if (tel) tel.textContent = '「' + q.text + '」'
      if (ael) ael.textContent = '— ' + q.author
    } // end quote block

    {
      // === enter transition with particle scatter ===
      const btn = document.getElementById('enter-btn')
      const root = document.getElementById('entrance-root')
      const particles = window.__particles
      if (btn && root) {
        const doEnter = (e) => {
          if (e) e.preventDefault()
          const href = btn.getAttribute('href')
          if (!href) return

          if (reduceMotion) {
            location.href = href
            return
          }

          root.classList.add('is-leaving')

          // Scatter all particles outward
          if (particles) {
            particles.scattering = true
            const { fireflies, leaves } = particles
            fireflies.forEach((f) => {
              const angle = Math.random() * Math.PI * 2
              const speed = 4 + Math.random() * 8
              f.vx = Math.cos(angle) * speed
              f.vy = Math.sin(angle) * speed - 3
            })
            leaves.forEach((l) => {
              const angle = -Math.PI / 2 + (Math.random() - 0.5) * 1.2
              const speed = 5 + Math.random() * 10
              l.vx = Math.cos(angle) * speed
              l.vy = Math.sin(angle) * speed
            })
          }

          document.removeEventListener('keydown', onKeyDown)
          setTimeout(() => {
            location.href = href
          }, 560)
        }
        const onKeyDown = (e) => {
          if (e.key !== 'Enter' || document.activeElement !== btn) return
          e.preventDefault()
          doEnter(e)
        }
        btn.addEventListener('click', doEnter)
        document.addEventListener('keydown', onKeyDown)
        document.addEventListener(
          'astro:before-swap',
          () => {
            btn.removeEventListener('click', doEnter)
            document.removeEventListener('keydown', onKeyDown)
          },
          { once: true },
        )
      }
    } // end transition block

    {
      // === scroll parallax on entry bg ===
      const bgMedia = document.querySelector('.bg-media')
      if (bgMedia && !reduceMotion) {
        let ticking = false
        const onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              const y = window.scrollY
              bgMedia.style.transform = `translateY(${(y * 0.15).toFixed(1)}px) scale(1.04)`
              ticking = false
            })
            ticking = true
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true })
        document.addEventListener(
          'astro:before-swap',
          () => {
            window.removeEventListener('scroll', onScroll)
          },
          { once: true },
        )
      }
    } // end scroll parallax

    {
      // === click ripple on entrance ===
      const root = document.getElementById('entrance-root')
      if (root && !reduceMotion) {
        const onRootClick = (e) => {
          if (e.target.closest('a, button, .enter-btn')) return
          const ripple = document.createElement('div')
          const size = 120 + Math.random() * 80
          ripple.style.cssText = `position:absolute;left:${e.clientX}px;top:${e.clientY}px;width:${size}px;height:${size}px;border-radius:50%;pointer-events:none;z-index:6;background:radial-gradient(circle,rgba(200,182,142,0.10) 0%,transparent 70%);transform:translate(-50%,-50%) scale(0);opacity:1;`
          root.appendChild(ripple)
          const anim = ripple.animate(
            [
              { transform: 'translate(-50%,-50%) scale(0)', opacity: 0.6 },
              { transform: 'translate(-50%,-50%) scale(1.5)', opacity: 0 },
            ],
            { duration: 800, easing: 'cubic-bezier(0.16,1,0.3,1)' },
          )
          anim.onfinish = () => ripple.remove()
        }

        root.addEventListener('click', onRootClick)
        document.addEventListener(
          'astro:before-swap',
          () => {
            root.removeEventListener('click', onRootClick)
          },
          { once: true },
        )
      }
    } // end click ripple
  </script>
</BaseLayout>

<style>
  .entrance-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #070a13;
    transition:
      opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      filter 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .entrance-container.is-leaving {
    opacity: 0;
    filter: blur(8px) saturate(0.55) brightness(0.82);
    transform: scale(1.025);
    pointer-events: none;
  }

  .entrance-container::before,
  .entrance-container::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .entrance-container::before {
    inset: 0;
    z-index: 4;
    background:
      linear-gradient(
        90deg,
        rgba(5, 7, 13, 0.58) 0%,
        rgba(5, 7, 13, 0.18) 42%,
        rgba(5, 7, 13, 0.22) 100%
      ),
      linear-gradient(
        155deg,
        rgba(236, 244, 255, 0.08) 0%,
        transparent 34%,
        rgba(166, 82, 48, 0.04) 72%,
        transparent 100%
      ),
      radial-gradient(
        ellipse 48% 42% at 50% 48%,
        transparent 0 42%,
        rgba(3, 5, 10, 0.2) 78%,
        rgba(3, 5, 10, 0.42) 100%
      ),
      radial-gradient(ellipse 50% 44% at 24% 58%, rgba(122, 149, 175, 0.07), transparent 70%);
  }

  .entrance-container::after {
    bottom: 0;
    left: 0;
    width: 100%;
    height: 82%;
    background:
      radial-gradient(ellipse 72% 24% at 50% 100%, rgba(185, 116, 66, 0.1), transparent 62%),
      linear-gradient(
        to top,
        rgba(5, 7, 13, 0.72) 0%,
        rgba(5, 7, 13, 0.38) 32%,
        rgba(5, 7, 13, 0.12) 62%,
        transparent 100%
      );
    z-index: 5;
  }

  .bg-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .bg-layer::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: #030507;
    animation: bootVeil 2.1s 0.08s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bg-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.56;
    filter: saturate(0.92) brightness(1.04) contrast(1.02);
    transform: scale(1.025);
    will-change: transform;
    animation: bootMediaWake 2.8s 0.05s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes bootVeil {
    0% {
      opacity: 0.88;
    }
    45% {
      opacity: 0.72;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes bootMediaWake {
    0% {
      filter: saturate(0.55) brightness(0.62) contrast(1.08);
    }
    100% {
      filter: saturate(0.92) brightness(1.04) contrast(1.02);
    }
  }

  .particle-canvas {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .fog-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 34% at 50% 48%, rgba(220, 236, 255, 0.045), transparent 58%),
      radial-gradient(ellipse 54% 44% at 30% 58%, transparent 36%, rgba(7, 10, 19, 0.2) 74%),
      radial-gradient(ellipse 80% 74% at 50% 45%, transparent 36%, rgba(7, 10, 19, 0.54) 100%);
  }

  .entrance-scene {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }

  .entrance-orbit,
  .entrance-spine,
  .entrance-corner-light {
    position: absolute;
    pointer-events: none;
  }

  .entrance-orbit {
    border: 1px solid rgba(190, 216, 238, 0.08);
    border-radius: 50%;
    filter: blur(0.2px);
    opacity: 0.72;
    animation: sceneOrbitDrift 18s ease-in-out infinite;
  }

  .entrance-orbit--cold {
    width: min(58vw, 720px);
    aspect-ratio: 1;
    top: 7vh;
    right: -16vw;
    border-color: rgba(176, 212, 242, 0.105);
    box-shadow:
      inset 0 0 90px rgba(122, 149, 175, 0.035),
      0 0 70px rgba(122, 149, 175, 0.045);
  }

  .entrance-orbit--warm {
    width: min(42vw, 520px);
    aspect-ratio: 1;
    left: -12vw;
    bottom: 7vh;
    border-color: rgba(218, 158, 92, 0.075);
    box-shadow:
      inset 0 0 80px rgba(180, 86, 48, 0.035),
      0 0 60px rgba(200, 142, 82, 0.038);
    animation-delay: -7s;
  }

  .entrance-spine {
    top: 12vh;
    left: 7vw;
    width: 1px;
    height: 62vh;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(214, 232, 248, 0.12) 18%,
      rgba(218, 158, 92, 0.08) 54%,
      transparent
    );
    opacity: 0.72;
    transform: rotate(7deg);
    transform-origin: 50% 50%;
    animation: sceneSpineBreathe 8s ease-in-out infinite;
  }

  .entrance-corner-light {
    right: -18vw;
    top: -22vh;
    width: min(58vw, 720px);
    height: min(58vw, 720px);
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 42% 46%, rgba(230, 241, 255, 0.105), transparent 42%),
      radial-gradient(ellipse at 56% 64%, rgba(188, 104, 58, 0.06), transparent 68%);
    filter: blur(36px);
    opacity: 0.74;
    animation: sceneLightBreathe 11s ease-in-out infinite;
  }

  .cursor-glow {
    position: fixed;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(122, 149, 175, 0.045) 0%,
      rgba(160, 140, 100, 0.018) 38%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 3;
    transform: translate3d(-999px, -999px, 0) translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .film-grain {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 8;
    pointer-events: none;
  }

  @keyframes sceneOrbitDrift {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      opacity: 0.58;
    }
    50% {
      transform: translate3d(-18px, 10px, 0) rotate(8deg) scale(1.035);
      opacity: 0.86;
    }
  }

  @keyframes sceneSpineBreathe {
    0%,
    100% {
      opacity: 0.42;
      transform: rotate(7deg) scaleY(0.96);
    }
    50% {
      opacity: 0.78;
      transform: rotate(7deg) scaleY(1.04);
    }
  }

  @keyframes sceneLightBreathe {
    0%,
    100% {
      opacity: 0.48;
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      opacity: 0.78;
      transform: translate3d(-16px, 18px, 0) scale(1.06);
    }
  }

  .content-layer {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: min(86vw, 680px);
    margin-top: 2vh;
    isolation: isolate;
  }

  .content-layer::before {
    content: '';
    position: absolute;
    inset: -90px -120px -72px;
    z-index: -2;
    pointer-events: none;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 50% 38%, rgba(245, 250, 255, 0.115), transparent 34%),
      radial-gradient(ellipse at 50% 60%, rgba(122, 149, 175, 0.07), transparent 58%),
      radial-gradient(ellipse at 54% 84%, rgba(190, 120, 72, 0.055), transparent 72%);
    filter: blur(18px);
    opacity: 0.86;
    animation: contentAuraBreathe 10s ease-in-out infinite;
  }

  .content-layer::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 51%;
    width: min(720px, 92vw);
    height: 1px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(210, 230, 245, 0.12),
      rgba(220, 170, 104, 0.08),
      transparent
    );
    transform: translateX(-50%);
    opacity: 0.62;
  }

  @keyframes contentAuraBreathe {
    0%,
    100% {
      opacity: 0.64;
      transform: scale(0.98);
    }
    50% {
      opacity: 0.94;
      transform: scale(1.04);
    }
  }

  /* ── Ink bloom ambient light spots ── */
  .ink-blooms {
    position: absolute;
    inset: -120px -200px;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .ink-bloom {
    position: absolute;
    border-radius: 50%;
    filter: blur(44px);
    opacity: 0;
    animation: bloomDrift var(--drift-dur, 14s) var(--drift-delay, 0s) ease-in-out infinite;
  }

  .ink-bloom--a {
    width: 240px;
    height: 170px;
    top: 12%;
    left: 10%;
    background: radial-gradient(
      ellipse,
      rgba(122, 149, 175, 0.08) 0%,
      rgba(200, 182, 142, 0.026) 48%,
      transparent 72%
    );
    --drift-dur: 18s;
    animation-delay: 1.8s;
  }

  .ink-bloom--b {
    width: 280px;
    height: 210px;
    top: 34%;
    right: 6%;
    background: radial-gradient(
      ellipse,
      rgba(140, 150, 180, 0.07) 0%,
      rgba(160, 140, 100, 0.018) 42%,
      transparent 72%
    );
    --drift-dur: 21s;
    animation-delay: 0s;
  }

  @keyframes bloomDrift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.35;
    }
    25% {
      transform: translate(40px, -18px) scale(1.08);
      opacity: 0.55;
    }
    50% {
      transform: translate(-15px, -30px) scale(0.92);
      opacity: 0.3;
    }
    75% {
      transform: translate(-35px, 10px) scale(1.05);
      opacity: 0.5;
    }
  }

  /* ── Maple glass boot mark ── */
  .maple-boot-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 110px;
    height: 110px;
    margin-bottom: 1.95rem;
    opacity: 0;
    filter: blur(20px) brightness(1.45);
    transform: translateY(10px) scale(0.82);
    animation: mapleBootReveal 3.7s 0.08s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .maple-boot-icon::before,
  .maple-boot-icon::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .maple-boot-icon::before {
    inset: -24px;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 40% 30%, rgba(255, 255, 255, 0.3), transparent 34%),
      radial-gradient(ellipse at 50% 56%, rgba(190, 220, 244, 0.11), transparent 58%),
      radial-gradient(ellipse at 54% 70%, rgba(174, 71, 42, 0.08), transparent 72%);
    filter: blur(24px);
    opacity: 0;
    animation: mapleHaloWake 2.8s 0.14s ease-out forwards;
  }

  .maple-boot-icon::after {
    inset: 0 20px 14px;
    background: linear-gradient(
      118deg,
      transparent 16%,
      rgba(255, 255, 255, 0.64) 38%,
      rgba(255, 255, 255, 0.18) 46%,
      transparent 60%
    );
    clip-path: polygon(
      48% 0,
      60% 26%,
      92% 18%,
      72% 44%,
      100% 52%,
      68% 60%,
      82% 88%,
      54% 72%,
      48% 100%,
      42% 72%,
      14% 88%,
      28% 60%,
      0 52%,
      28% 44%,
      8% 18%,
      40% 26%
    );
    opacity: 0;
    transform: translateX(-38%);
    animation: mapleGlassSheen 2.55s 0.46s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .maple-glyph {
    position: relative;
    z-index: 1;
    width: 88px;
    height: 88px;
    fill: url(#mapleGlass);
    stroke: rgba(255, 255, 255, 0.42);
    stroke-width: 1.15;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 16px rgba(255, 255, 255, 0.16))
      drop-shadow(0 0 28px rgba(183, 214, 238, 0.12)) drop-shadow(0 12px 24px rgba(0, 0, 0, 0.32));
  }

  .maple-vein {
    fill: none;
    stroke: rgba(255, 255, 255, 0.15);
    stroke-width: 1.05;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 7px rgba(255, 255, 255, 0.12));
  }

  @keyframes mapleBootReveal {
    0% {
      opacity: 0;
      filter: blur(26px) brightness(1.65);
      transform: translateY(12px) scale(0.76);
    }
    18% {
      opacity: 1;
      filter: blur(5px) brightness(1.2);
      transform: translateY(0) scale(1.06);
    }
    62% {
      opacity: 1;
      filter: blur(0) brightness(1.02);
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      filter: blur(20px) brightness(1.16);
      transform: translateY(-10px) scale(0.9);
    }
  }

  @keyframes mapleHaloWake {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    44% {
      opacity: 0.74;
      transform: scale(1.08);
    }
    100% {
      opacity: 0;
      transform: scale(1.26);
    }
  }

  @keyframes mapleGlassSheen {
    0%,
    22% {
      opacity: 0;
      transform: translateX(-42%);
    }
    48% {
      opacity: 0.62;
    }
    100% {
      opacity: 0;
      transform: translateX(34%);
    }
  }

  /* ── Editorial stagger reveal title ── */
  .editorial-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    position: relative;
  }

  .editorial-title::before {
    content: '';
    position: absolute;
    top: 52%;
    left: 50%;
    width: 420px;
    height: 250px;
    background:
      radial-gradient(
        ellipse at 50% 46%,
        rgba(245, 248, 255, 0.115) 0%,
        rgba(122, 149, 175, 0.052) 38%,
        transparent 72%
      ),
      radial-gradient(ellipse at 60% 70%, rgba(200, 182, 142, 0.05), transparent 66%);
    transform: translate(-50%, -50%);
    z-index: -1;
    pointer-events: none;
    animation:
      bootTitleAura 2.45s 0.18s cubic-bezier(0.16, 1, 0.3, 1) both,
      titleGlow 9s 2.7s ease-in-out infinite;
  }

  @keyframes bootTitleAura {
    0% {
      opacity: 0;
      filter: blur(18px);
      transform: translate(-50%, -50%) scale(0.92);
    }
    100% {
      opacity: 0.48;
      filter: blur(0);
      transform: translate(-50%, -50%) scale(0.98);
    }
  }

  @keyframes titleGlow {
    0%,
    100% {
      opacity: 0.42;
      transform: translate(-50%, -50%) scale(0.98);
    }
    50% {
      opacity: 0.72;
      transform: translate(-50%, -50%) scale(1.06);
    }
  }

  .editorial-chars {
    display: flex;
    align-items: baseline;
    gap: 0.035em;
    font-family:
      'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'STSong', var(--font-serif), serif;
    font-size: clamp(4.25rem, 9.35vw, 7rem);
    font-weight: 600;
    letter-spacing: 0.035em;
    color: rgba(250, 250, 249, 0.92);
    line-height: 1.02;
    font-optical-sizing: auto;
    font-variation-settings: 'wght' 600;
  }

  .handwriting-title {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(360px, 76vw);
    aspect-ratio: 12 / 5;
    transform: translate(-50%, -40%);
    opacity: 0;
    filter: blur(8px) brightness(1.24);
    pointer-events: none;
    z-index: 2;
    animation: handwritingLayerWake 3.1s 3.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .handwriting-word {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.035em;
    font-family:
      'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'STSong', var(--font-serif), serif;
    font-size: clamp(4.25rem, 9.35vw, 7rem);
    font-weight: 600;
    letter-spacing: 0.055em;
    line-height: 1.02;
    font-optical-sizing: auto;
    font-variation-settings: 'wght' 600;
  }

  .handwriting-char {
    position: relative;
    display: inline-block;
    width: 1.02em;
    height: 1.04em;
  }

  .handwriting-piece {
    position: absolute;
    inset: 0;
    color: rgba(250, 253, 255, 0.78);
    opacity: 0;
    overflow: hidden;
    text-shadow:
      0 0 12px rgba(255, 255, 255, 0.18),
      0 0 26px rgba(150, 178, 208, 0.14),
      0 12px 30px rgba(0, 0, 0, 0.3);
    animation: handwritingPieceWake 0.42s var(--delay) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .handwriting-char--trace .handwriting-piece {
    color: rgba(236, 245, 252, 0.7);
  }

  .handwriting-piece--mo-1 {
    clip-path: inset(0 0 76% 0);
  }
  .handwriting-piece--mo-2 {
    clip-path: inset(16% 36% 52% 34%);
  }
  .handwriting-piece--mo-3 {
    clip-path: inset(24% 8% 48% 8%);
  }
  .handwriting-piece--mo-4 {
    clip-path: inset(36% 12% 38% 12%);
  }
  .handwriting-piece--mo-5 {
    clip-path: inset(48% 18% 30% 18%);
  }
  .handwriting-piece--mo-6 {
    clip-path: inset(56% 0 18% 0);
  }
  .handwriting-piece--mo-7 {
    clip-path: inset(64% 40% 0 40%);
  }
  .handwriting-piece--mo-8 {
    clip-path: inset(76% 0 8% 0);
  }
  .handwriting-piece--mo-9 {
    clip-path: inset(84% 6% 0 6%);
  }
  .handwriting-piece--ji-1 {
    clip-path: inset(0 66% 62% 0);
  }
  .handwriting-piece--ji-2 {
    clip-path: inset(28% 70% 24% 0);
  }
  .handwriting-piece--ji-3 {
    clip-path: inset(70% 54% 0 0);
  }
  .handwriting-piece--ji-4 {
    clip-path: inset(0 0 64% 36%);
  }
  .handwriting-piece--ji-5 {
    clip-path: inset(28% 0 50% 34%);
  }
  .handwriting-piece--ji-6 {
    clip-path: inset(30% 18% 16% 52%);
  }
  .handwriting-piece--ji-7 {
    clip-path: inset(52% 2% 26% 34%);
  }
  .handwriting-piece--ji-8 {
    clip-path: inset(74% 0 0 0);
  }

  .editorial-char {
    --glyph-core: rgba(255, 255, 252, 0.98);
    --glyph-cool: rgba(199, 216, 232, 0.78);
    --glyph-ink: rgba(70, 86, 102, 0.42);
    --glyph-warm: rgba(214, 194, 148, 0.13);
    position: relative;
    isolation: isolate;
    display: inline-block;
    color: rgba(248, 250, 246, 0.94);
    background:
      radial-gradient(ellipse at 48% 38%, rgba(255, 255, 255, 0.96) 0 16%, transparent 48%),
      radial-gradient(ellipse at 42% 62%, var(--glyph-ink) 0 14%, transparent 46%),
      linear-gradient(
        172deg,
        rgba(255, 255, 255, 0.98) 0%,
        var(--glyph-cool) 48%,
        rgba(233, 224, 198, 0.82) 100%
      );
    background-size:
      128% 128%,
      150% 150%,
      100% 100%;
    background-position:
      48% 38%,
      42% 62%,
      center;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    filter: blur(26px) brightness(1.35);
    text-shadow:
      0 0 0 rgba(245, 248, 255, 0),
      0 0 0 rgba(122, 149, 175, 0);
    will-change: transform, opacity, filter, background-position;
    animation:
      bootGlyphWake 2.8s var(--glyph-delay) cubic-bezier(0.16, 1, 0.3, 1) forwards,
      inkWashDrift 13s var(--drift-delay) ease-in-out infinite;
  }

  .editorial-char--ink {
    --glyph-core: rgba(255, 255, 252, 1);
    --glyph-cool: rgba(196, 219, 236, 0.84);
    --glyph-ink: rgba(42, 60, 78, 0.6);
    --glyph-warm: rgba(186, 164, 124, 0.12);
    font-size: 1.04em;
    transform-origin: 56% 64%;
  }

  .editorial-char--trace {
    --glyph-core: rgba(252, 248, 236, 0.96);
    --glyph-cool: rgba(214, 224, 235, 0.7);
    --glyph-ink: rgba(95, 104, 118, 0.34);
    --glyph-warm: rgba(232, 199, 138, 0.24);
    margin-left: -0.015em;
    font-size: 0.965em;
    transform-origin: 44% 62%;
  }

  .editorial-char--ink::before {
    inset: -10% -18% -1%;
  }

  .editorial-char--trace::before {
    inset: -5% -22% 2% -10%;
    filter: blur(22px);
  }

  .editorial-char::before,
  .editorial-char::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .editorial-char::before {
    inset: -8% -18% -2%;
    z-index: -1;
    background:
      radial-gradient(ellipse at 48% 42%, rgba(248, 252, 255, 0.18), transparent 42%),
      radial-gradient(ellipse at 48% 54%, rgba(132, 170, 205, 0.11), transparent 64%),
      radial-gradient(ellipse at 60% 62%, var(--glyph-warm), transparent 72%);
    filter: blur(24px);
    opacity: 0;
    transform: scale(0.64);
    animation: inkBloomWake 2.9s var(--bloom-delay) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .editorial-char::after {
    inset: 8% -5% 10%;
    z-index: 1;
    background:
      radial-gradient(ellipse at 72% 22%, rgba(232, 199, 138, 0.2), transparent 18%),
      linear-gradient(110deg, transparent 16%, rgba(255, 255, 255, 0.24) 44%, transparent 58%),
      repeating-linear-gradient(90deg, transparent 0 16px, rgba(218, 234, 246, 0.04) 16px 17px);
    mix-blend-mode: screen;
    opacity: 0;
    transform: translateX(-44%) skewX(-8deg);
    animation: inkTraceWake 2.6s var(--trace-delay) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .editorial-char--ink::after {
    background:
      radial-gradient(ellipse at 32% 74%, rgba(110, 144, 178, 0.18), transparent 20%),
      linear-gradient(112deg, transparent 18%, rgba(255, 255, 255, 0.2) 42%, transparent 56%),
      repeating-linear-gradient(90deg, transparent 0 17px, rgba(218, 234, 246, 0.035) 17px 18px);
  }

  .editorial-char--trace::after {
    inset: 4% -18% 6% -2%;
    background:
      radial-gradient(ellipse at 76% 18%, rgba(232, 199, 138, 0.3), transparent 16%),
      linear-gradient(122deg, transparent 10%, rgba(255, 246, 218, 0.28) 42%, transparent 58%);
  }

  @supports not ((background-clip: text) or (-webkit-background-clip: text)) {
    .editorial-char {
      background: none;
      color: rgba(248, 250, 246, 0.94);
      -webkit-text-fill-color: rgba(248, 250, 246, 0.94);
    }
  }

  .editorial-line {
    display: block;
    width: 0;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(122, 149, 175, 0.5) 28%,
        rgba(229, 199, 134, 0.34) 52%,
        rgba(122, 149, 175, 0.2) 72%,
        transparent
      ),
      radial-gradient(circle, rgba(255, 255, 255, 0.36), transparent 62%);
    margin-bottom: 1.05rem;
    box-shadow: 0 0 18px rgba(200, 182, 142, 0.08);
    animation: lineExpand 0.9s 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes handwritingLayerWake {
    0% {
      opacity: 0;
      filter: blur(12px) brightness(1.35);
    }
    18% {
      opacity: 1;
      filter: blur(4px) brightness(1.18);
    }
    70% {
      opacity: 0.88;
      filter: blur(0) brightness(1.06);
    }
    100% {
      opacity: 0;
      filter: blur(10px) brightness(1.16);
    }
  }

  @keyframes handwritingPieceWake {
    0% {
