---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.noindex)
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const base = import.meta.env.BASE_URL

// 按年分组
const yearGroups: Record<string, typeof sortedPosts> = {}
sortedPosts.forEach((p) => {
  const year = p.data.pubDate.getFullYear().toString()
  if (!yearGroups[year]) yearGroups[year] = []
  yearGroups[year].push(p)
})
---

<BaseLayout title="足迹" description="又逢雨季的成长足迹">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-10">
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">
        TIMELINE
      </span>
      <h1 class="font-display text-4xl font-bold text-text dark:text-dark-text mb-3">足迹</h1>
      <p class="text-text-muted dark:text-dark-text-muted font-serif">记录每一个脚印</p>
    </div>

    <div class="relative">
      <!-- 时间线 -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-accent/40 via-border/40 to-transparent dark:from-dark-accent/40 dark:via-dark-border/40"></div>

      {Object.entries(yearGroups).map(([year, posts]) => (
        <div class="mb-14">
          <!-- 年份标记 -->
          <div class="relative flex items-center mb-6">
            <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-accent dark:bg-dark-accent flex items-center justify-center z-10 shadow-lg shadow-accent/30 dark:shadow-dark-accent/30">
              <span class="text-xs font-bold text-white font-mono">{year.slice(2)}</span>
            </div>
            <h2 class="ml-16 md:ml-0 md:absolute md:left-1/2 md:translate-x-5 font-display text-xl font-bold text-text dark:text-dark-text">
              {year}
            </h2>
          </div>

          <!-- 文章列表 -->
          <div class="space-y-4 ml-16 md:ml-0">
            {posts.map((post, i) => (
              <div class:list={['relative ink-reveal', `ink-reveal-delay-${(i % 4) + 1}`]}>
                <!-- 连接点 -->
                <div class="absolute -left-[2.5rem] md:-left-[3rem] top-4 w-3 h-3 rounded-full border-2 border-accent dark:border-dark-accent bg-surface dark:bg-dark-surface"></div>
                <a
                  href={`${base}blog/${post.id}/`}
                  class="block p-5 border border-border/40 dark:border-dark-border/40 hover:border-accent/60 dark:hover:border-dark-accent/60 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/5 dark:hover:shadow-dark-accent/5 transition-all duration-300 group rounded-xl bg-gradient-to-br from-surface/50 to-surface-alt/30 dark:from-dark-surface/50 dark:to-dark-surface-alt/30"
                >
                  <div class="flex items-center gap-3 mb-2">
                    <time class="text-xs font-mono text-text-muted dark:text-dark-text-muted">
                      {post.data.pubDate.toLocaleDateString('zh-CN', {
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <span class="seal text-[10px]">{post.data.category}</span>
                  </div>
                  <h3 class="font-display text-base font-bold text-text dark:text-dark-text group-hover:text-accent dark:group-hover:text-dark-accent transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-text-muted dark:text-dark-text-muted mt-2 font-serif line-clamp-2">
                    {post.data.description}
                  </p>
                </a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
