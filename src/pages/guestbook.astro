---
import BaseLayout from '../layouts/BaseLayout.astro'
import Comment from '../components/Comment.astro'
---

<BaseLayout title="留言板" description="留下你的足迹，让我知道你来过。">
  <div class="max-w-3xl mx-auto px-6 py-16 relative">
    <!-- 竖排装饰字 -->
    <div class="absolute top-16 right-6 md:right-12 writing-vertical-rl font-display text-6xl md:text-8xl text-text/[0.03] dark:text-dark-text/[0.04] select-none pointer-events-none tracking-widest leading-none">
      留言
    </div>

    <div class="mb-10">
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">
        GUESTBOOK
      </span>
      <h1 class="font-display text-4xl font-bold text-text dark:text-dark-text mb-3">留言板</h1>
      <p class="text-text-muted dark:text-dark-text-muted font-serif leading-relaxed">
        欢迎留下你的足迹。可以聊聊技术、分享想法，或者只是打个招呼。
      </p>
    </div>

    <!-- 留言区域 -->
    <Comment />

    <!-- 联系方式 -->
    <div class="mt-14 p-8 border border-dashed border-border/40 dark:border-dark-border/40 bg-gradient-to-br from-surface/30 to-surface-alt/20 dark:from-dark-surface/30 dark:to-dark-surface-alt/20 rounded-xl">
      <h3 class="font-display text-sm font-semibold tracking-widest text-text-muted dark:text-dark-text-muted mb-5">
        其他方式
      </h3>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://github.com/bbw8000000"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2.5 px-5 py-2.5 border border-border/60 dark:border-dark-border/60 text-sm text-text dark:text-dark-text hover:border-accent/60 dark:hover:border-dark-accent/60 hover:text-accent dark:hover:text-dark-accent hover:shadow-md hover:shadow-accent/10 dark:hover:shadow-dark-accent/10 transition-all duration-300 font-sans rounded-xl"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          GitHub
        </a>
        <a
          href="mailto:bbw8000000@users.noreply.github.com"
          class="flex items-center gap-2.5 px-5 py-2.5 border border-border/60 dark:border-dark-border/60 text-sm text-text dark:text-dark-text hover:border-accent/60 dark:hover:border-dark-accent/60 hover:text-accent dark:hover:text-dark-accent hover:shadow-md hover:shadow-accent/10 dark:hover:shadow-dark-accent/10 transition-all duration-300 font-sans rounded-xl"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            />
          </svg>
          邮件
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .writing-vertical-rl {
    writing-mode: vertical-rl;
  }
</style>
