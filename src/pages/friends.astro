---
import BaseLayout from '../layouts/BaseLayout.astro'

const friends = [
  {
    name: '技术日报',
    desc: 'GitHub 热门 + 技术圈每日动态',
    url:
      import.meta.env.PUBLIC_TECH_DAILY_URL?.trim() ||
      'https://ekegukeku64-blip.github.io/tech-daily/',
    avatar: '📰',
  },
]
---

<BaseLayout title="友链" description="友情链接">
  <div class="max-w-3xl mx-auto px-6 py-16 relative">
    <!-- 竖排装饰字 -->
    <div class="absolute top-16 right-6 md:right-12 writing-vertical-rl font-display text-6xl md:text-8xl text-text/[0.03] dark:text-dark-text/[0.04] select-none pointer-events-none tracking-widest leading-none">
      友链
    </div>

    <div class="mb-10">
      <span class="inline-block px-3 py-1 text-xs font-sans tracking-widest text-accent dark:text-dark-accent border border-accent/30 dark:border-dark-accent/30 mb-4">
        FRIENDS
      </span>
      <h1 class="font-display text-4xl font-bold text-text dark:text-dark-text mb-3">友情链接</h1>
      <p class="text-text-muted dark:text-dark-text-muted font-serif">
        这里是一些我觉得值得关注的站点。如果你也想交换友链，可以通过 GitHub 联系我。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {friends.map((friend) => (
        <a
          href={friend.url}
          target="_blank"
          rel="noopener"
          class="group flex items-start gap-4 p-6 border border-border/40 dark:border-dark-border/40 rounded-xl shadow-sm hover:border-accent/60 dark:hover:border-dark-accent/60 hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/5 dark:hover:shadow-dark-accent/5 transition-all duration-300 bg-gradient-to-br from-surface/50 to-surface-alt/30 dark:from-dark-surface/50 dark:to-dark-surface-alt/30"
        >
          <div class="w-14 h-14 rounded-xl bg-accent/10 dark:bg-dark-accent/10 flex items-center justify-center text-2xl shrink-0 border border-accent/20 dark:border-dark-accent/20">
            {friend.avatar}
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-display font-bold text-lg text-text dark:text-dark-text group-hover:text-accent dark:group-hover:text-dark-accent transition-colors">
              {friend.name}
            </h3>
            <p class="text-sm text-text-muted dark:text-dark-text-muted mt-1.5 font-serif">
              {friend.desc}
            </p>
          </div>
          <svg
            class="w-5 h-5 text-text-muted/40 dark:text-dark-text-muted/40 group-hover:text-accent dark:group-hover:text-dark-accent transition-colors shrink-0 mt-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      ))}
    </div>

    <div class="mt-12 p-8 border border-dashed border-border/40 dark:border-dark-border/40 text-center bg-gradient-to-br from-surface/30 to-surface-alt/20 dark:from-dark-surface/30 dark:to-dark-surface-alt/20 rounded-xl">
      <p class="text-text-muted dark:text-dark-text-muted font-serif text-sm">
        想交换友链？通过{' '}
        <a
          href="https://github.com/bbw8000000"
          target="_blank"
          rel="noopener"
          class="text-accent dark:text-dark-accent hover:underline"
        >
          GitHub
        </a>{' '}
        联系我吧。
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .writing-vertical-rl {
    writing-mode: vertical-rl;
  }
</style>
