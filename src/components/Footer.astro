---
import { getCollection } from 'astro:content'
const year = new Date().getFullYear()
const base = import.meta.env.BASE_URL
const techDailyUrl =
  import.meta.env.PUBLIC_TECH_DAILY_URL?.trim() || 'https://ekegukeku64-blip.github.io/tech-daily/'

const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.noindex)
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<footer class="mt-auto relative">
  <div class="absolute top-0 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-accent/10 to-transparent"></div>
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
      <!-- 关于 -->
      <div class="reveal-target">
        <h3 class="font-display text-sm font-bold text-text mb-4 tracking-wide flex items-center gap-2">
          <span class="w-1 h-4 bg-accent/40 rounded-full"></span>
          盘腿修仙
        </h3>
        <p class="text-sm text-text-muted font-serif leading-relaxed">
          一个走非主流路线的大专生，在迷茫中摸索，在试错中成长。
        </p>
      </div>

      <!-- 导航 -->
      <div class="reveal-target">
        <h3 class="font-display text-sm font-bold text-text mb-4 tracking-wide flex items-center gap-2">
          <span class="w-1 h-4 bg-accent/40 rounded-full"></span>
          导航
        </h3>
        <div class="flex flex-col gap-2">
          <a
            href={`${base}home/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            首页
          </a>
          <a
            href={`${base}blog/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            文章
          </a>
          <a
            href={`${base}archive/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            归档
          </a>
          <a
            href={`${base}tools/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            工具
          </a>
          <a
            href={`${base}friends/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            友链
          </a>
          <a
            href={`${base}about/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            关于
          </a>
          <a
            href={`${base}privacy/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            隐私说明
          </a>
          <a
            href={`${base}disclaimer/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            内容声明
          </a>
          <a
            href={`${base}bookmarks/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            我的收藏
          </a>
          <a
            href={`${base}timeline/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            时间线
          </a>
          <a
            href={`${base}stats/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            站点统计
          </a>
          <a
            href={`${base}sitemap-page/`}
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            站点地图
          </a>
        </div>
      </div>

      <!-- 最近更新 -->
      <div class="reveal-target">
        <h3 class="font-display text-sm font-bold text-text mb-4 tracking-wide flex items-center gap-2">
          <span class="w-1 h-4 bg-accent/40 rounded-full"></span>
          最近更新
        </h3>
        <div class="flex flex-col gap-3">
          {recentPosts.map((post) => (
            <a href={`${base}blog/${post.id}/`} class="group/post">
              <p class="text-sm text-text-muted group-hover/post:text-accent transition-colors font-serif line-clamp-1">
                {post.data.title}
              </p>
              <p class="text-[11px] text-text-muted/40 font-serif mt-0.5">
                {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
              </p>
            </a>
          ))}
        </div>
      </div>

      <!-- 联系 -->
      <div class="reveal-target">
        <h3 class="font-display text-sm font-bold text-text mb-4 tracking-wide flex items-center gap-2">
          <span class="w-1 h-4 bg-accent/40 rounded-full"></span>
          联系
        </h3>
        <div class="flex flex-col gap-2">
          <a
            href="https://github.com/bbw8000000"
            target="_blank"
            rel="noopener"
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            GitHub
          </a>
          <a
            href={`${base}rss.xml`}
            target="_blank"
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            RSS 订阅
          </a>
          <a
            href={techDailyUrl}
            target="_blank"
            rel="noopener"
            class="text-sm text-text-muted hover:text-accent transition-all duration-300 font-serif hover:translate-x-1 inline-block"
          >
            技术日报
          </a>
        </div>
      </div>
    </div>

    <!-- 底部 -->
    <div class="pt-6 border-t border-white/[0.04] flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-text-muted/50 reveal-target">
      <p class="font-serif">&copy; {year} 又逢雨季 · 盘腿修仙</p>
      <div class="flex items-center gap-3 font-serif">
        <span>雨天更适合相遇</span>
      </div>
    </div>
  </div>
</footer>
