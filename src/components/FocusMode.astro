---
// 焦点模式 — 隐藏侧边栏，沉浸阅读
---

<button
  id="focus-toggle"
  class="fixed bottom-8 right-20 z-50 w-9 h-9 flex items-center justify-center
         border border-border/60 dark:border-dark-border/60 rounded-xl
         bg-surface/80 dark:bg-dark-surface/80 backdrop-blur-sm
         text-text-muted dark:text-dark-text-muted
         hover:text-accent dark:hover:text-dark-accent hover:border-accent dark:hover:border-dark-accent
         hover:shadow-md hover:shadow-accent/10 dark:hover:shadow-dark-accent/10
         transition-all duration-300 opacity-0 pointer-events-none"
  aria-label="焦点模式"
  title="焦点模式 (F)"
>
  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
  </svg>
</button>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    window.__focusCleanup?.()
    const controller = new AbortController()
    const btn = document.getElementById('focus-toggle')
    const aside = document.getElementById('toc-sidebar')
    if (!btn) return

    // 只在文章页显示
    if (aside) {
      btn.classList.remove('opacity-0', 'pointer-events-none')
      btn.classList.add('opacity-100', 'pointer-events-auto')
    }

    let focused = false
    btn.addEventListener(
      'click',
      () => {
        focused = !focused
        if (aside) aside.style.display = focused ? 'none' : ''
        btn.classList.toggle('text-accent', focused)
        btn.classList.toggle('dark:text-dark-accent', focused)
        btn.setAttribute('aria-pressed', String(focused))
      },
      { signal: controller.signal },
    )

    document.addEventListener(
      'keydown',
      (e) => {
        const target = e.target instanceof Element ? e.target : null
        if (e.key === 'f' && !e.metaKey && !e.ctrlKey && !target?.closest('input,textarea')) {
          btn.click()
        }
      },
      { signal: controller.signal },
    )
    window.__focusCleanup = () => {
      controller.abort()
      if (aside) aside.style.display = ''
    }
  })
</script>
