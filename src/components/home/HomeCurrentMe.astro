---
const notes = [
  '最近在继续打磨盘腿修仙：让它不只是好看，也更像一个真的人在慢慢经营。',
  '也在试着把 AI 工具放进日常工作和创作里，不追求炫技，先解决真实问题。',
  '偶尔还是会迷茫，但会把能做的小事先做出来，慢慢留下自己的痕迹。',
]
---

<section class="home-current-me reveal-target" aria-labelledby="home-current-me-heading">
  <div class="home-current-me-card">
    <div class="home-current-me-mark" aria-hidden="true">
      盤
    </div>
    <div class="home-current-me-copy">
      <span class="home-current-me-label">Recently</span>
      <h2 id="home-current-me-heading">最近的我</h2>
      <p>这里不只放文章和工具，也留一点正在发生的状态。</p>
    </div>
    <ul class="home-current-me-list">
      {notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-current-me {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .home-current-me-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(180px, 0.48fr) minmax(0, 1fr);
    gap: 1.35rem;
    align-items: center;
    overflow: hidden;
    padding: 1.45rem 1.65rem;
    border: 1px solid var(--border-glass);
    border-radius: 1.5rem;
    background:
      linear-gradient(145deg, rgba(32, 45, 68, 0.48), rgba(6, 10, 18, 0.28)),
      radial-gradient(ellipse at 6% 0%, rgba(200, 182, 142, 0.11), transparent 44%),
      radial-gradient(circle at 100% 100%, rgba(122, 149, 175, 0.09), transparent 46%);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    box-shadow: var(--shadow-glass-floating);
  }

  .home-current-me-card::after {
    content: '';
    position: absolute;
    right: -4rem;
    top: -5rem;
    width: 15rem;
    height: 15rem;
    border: 1px solid rgba(200, 182, 142, 0.08);
    border-radius: 42% 58% 52% 48%;
    transform: rotate(18deg);
    pointer-events: none;
  }

  .home-current-me-mark {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid rgba(200, 182, 142, 0.16);
    border-radius: 1.35rem;
    background:
      linear-gradient(145deg, rgba(200, 182, 142, 0.1), rgba(6, 10, 18, 0.22)),
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.1), transparent 58%);
    color: rgba(250, 250, 249, 0.88);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 16px 40px rgba(0, 0, 0, 0.26);
  }

  .home-current-me-copy,
  .home-current-me-list {
    position: relative;
    z-index: 1;
  }

  .home-current-me-label {
    display: inline-block;
    margin-bottom: 0.65rem;
    color: rgba(200, 182, 142, 0.78);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .home-current-me-copy h2 {
    margin-bottom: 0.45rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .home-current-me-copy p {
    color: rgba(168, 175, 186, 0.64);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .home-current-me-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-current-me-list li {
    position: relative;
    padding-left: 1rem;
    color: rgba(214, 218, 225, 0.72);
    font-family: var(--font-serif);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .home-current-me-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: rgba(200, 182, 142, 0.66);
    box-shadow: 0 0 18px rgba(200, 182, 142, 0.2);
  }

  @media (max-width: 900px) {
    .home-current-me-card {
      grid-template-columns: 1fr;
    }

    .home-current-me-mark {
      width: 3.75rem;
      height: 3.75rem;
      font-size: 1.7rem;
    }
  }

  @media (max-width: 768px) {
    .home-current-me {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .home-current-me-card {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
