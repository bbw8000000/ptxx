---
const items = [
  '正在打磨这个博客：视觉、内容结构和一点点个人气质。',
  '学习 AI 工具怎么真正嵌入日常工作和创作流。',
  '继续做实用小工具，也记录普通人能复制的小经验。',
]
---

<section class="home-now reveal-target" aria-labelledby="home-now-heading">
  <div class="home-now-inner">
    <div class="home-now-copy">
      <span class="home-now-label">Now</span>
      <h2 id="home-now-heading">此刻在做</h2>
      <p>不只是文章归档，也留一点当前状态。</p>
    </div>
    <ul class="home-now-list">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <a href={`${import.meta.env.BASE_URL}now/`} class="home-now-link">
      看完整 /now &rarr;
    </a>
  </div>
</section>

<style>
  .home-now {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .home-now-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr) auto;
    gap: 1.5rem;
    align-items: center;
    overflow: hidden;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--border-glass);
    border-radius: 1.5rem;
    background:
      linear-gradient(145deg, rgba(32, 45, 68, 0.5), rgba(6, 10, 18, 0.28)),
      radial-gradient(ellipse at 8% 0%, rgba(226, 238, 248, 0.12), transparent 48%),
      radial-gradient(circle at 100% 100%, rgba(200, 142, 82, 0.07), transparent 44%);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    box-shadow: var(--shadow-glass-floating);
  }

  .home-now-label {
    display: inline-block;
    margin-bottom: 0.7rem;
    color: rgba(200, 182, 142, 0.76);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .home-now-copy h2 {
    margin-bottom: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .home-now-copy p {
    color: rgba(168, 175, 186, 0.62);
    font-family: var(--font-serif);
    font-size: 0.82rem;
  }

  .home-now-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-now-list li {
    position: relative;
    padding-left: 1rem;
    color: rgba(214, 218, 225, 0.7);
    font-family: var(--font-serif);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .home-now-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: rgba(200, 182, 142, 0.62);
    box-shadow: 0 0 18px rgba(200, 182, 142, 0.18);
  }

  .home-now-link {
    justify-self: end;
    color: rgba(122, 149, 175, 0.72);
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    transition: color 0.3s;
  }

  .home-now-link:hover,
  .home-now-link:focus-visible {
    color: var(--color-accent);
  }

  .home-now-link:focus-visible {
    outline: 2px solid rgba(200, 182, 142, 0.42);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .home-now-inner {
      grid-template-columns: 1fr;
    }
    .home-now-link {
      justify-self: start;
    }
  }

  @media (max-width: 768px) {
    .home-now {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
    .home-now-inner {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
