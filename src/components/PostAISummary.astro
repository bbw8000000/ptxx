---
import { serializeJsonForScript } from '../utils/safeJson'

interface Props {
  content: string
  slug?: string
}

const { content, slug = '' } = Astro.props
const contentStr = content.replace(/[#*`\[\]()>|\\]/g, '').slice(0, 8000) // 清理 markdown 符号，限制长度
const summaryDataJson = serializeJsonForScript({ content: contentStr, slug })
---

<!-- 内容数据，供客户端 JS 读取 -->
<script is:inline id="ai-summary-data" type="application/json" set:html={summaryDataJson}></script>

<div id="ai-summary-root" class="mt-12 pt-8 border-t border-white/[0.05] reveal-target">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-accent/15 text-accent text-xs font-bold font-sans">
        摘
      </span>
      <h3 class="font-display text-sm font-bold text-text tracking-wide">本地摘要</h3>
    </div>
    <span id="ai-summary-status" class="text-[11px] text-text-muted font-serif">
      提取式 · 不上传内容
    </span>
  </div>

  <div id="ai-summary-body" class="relative">
    <button
      id="ai-summary-btn"
      class="w-full group relative overflow-hidden px-5 py-4 rounded-xl border border-dashed border-white/[0.08] bg-surface/20 hover:bg-surface/40 hover:border-accent/30 transition-all duration-500 cursor-pointer text-left"
      style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1)"
    >
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1">
          <span
            class="w-1.5 h-1.5 rounded-full bg-accent/60 animate-pulse"
            style="animation-duration: 1.8s;"
          ></span>
          <span
            class="w-1.5 h-1.5 rounded-full bg-accent/40 animate-pulse"
            style="animation-duration: 1.8s; animation-delay: 0.3s;"
          ></span>
          <span
            class="w-1.5 h-1.5 rounded-full bg-accent/20 animate-pulse"
            style="animation-duration: 1.8s; animation-delay: 0.6s;"
          ></span>
        </div>
        <span class="text-sm text-text-secondary font-serif group-hover:text-text transition-colors duration-300">
          生成本地摘要
        </span>
      </div>
    </button>

    <div id="ai-summary-result" class="hidden">
      <div
        id="ai-summary-text"
        class="text-sm text-text-secondary font-serif leading-[2] p-5 rounded-xl bg-surface/10 border border-white/[0.05]"
      ></div>
      <div id="ai-summary-actions" class="flex items-center gap-3 mt-3 hidden">
        <button
          id="ai-summary-regenerate"
          class="text-xs text-text-muted hover:text-accent transition-colors font-serif cursor-pointer"
        >
          重新生成
        </button>
        <span class="text-text-muted/20">·</span>
        <span id="ai-summary-word-count" class="text-[11px] text-text-muted/50 font-mono"></span>
      </div>
    </div>
  </div>
</div>

<script>
  import { summarize } from '../utils/summarize'

  const MIN_CHARS = 200

  function initPostSummary() {
    const btn = document.getElementById('ai-summary-btn') as HTMLButtonElement | null
    if (!btn || btn.dataset.summaryReady === 'true') return
    const summaryButton: HTMLButtonElement = btn
    summaryButton.dataset.summaryReady = 'true'

    const result = document.getElementById('ai-summary-result') as HTMLElement
    const resultText = document.getElementById('ai-summary-text') as HTMLElement
    const status = document.getElementById('ai-summary-status') as HTMLElement
    const actions = document.getElementById('ai-summary-actions') as HTMLElement
    const regenerate = document.getElementById('ai-summary-regenerate') as HTMLButtonElement
    const wordCount = document.getElementById('ai-summary-word-count') as HTMLElement
    const dataEl = document.getElementById('ai-summary-data') as HTMLScriptElement
    const data = dataEl ? JSON.parse(dataEl.textContent || '{}') : { content: '', slug: '' }
    const content = (data.content || '') as string
    const storageKey =
      'ai-summary-' + (data.slug || window.location.pathname.replace(/\/blog\/(.+?)\/?$/, '$1'))

    function generate() {
      if (content.length < MIN_CHARS) {
        resultText.textContent = '文章内容较短，无需生成摘要。'
        result.classList.remove('hidden')
        summaryButton.classList.add('hidden')
        return
      }

      summaryButton.classList.add('hidden')
      result.classList.add('hidden')
      try {
        const sentences = summarize(content)
        const summary = sentences.join('')
        const display = summary.length > 600 ? summary.slice(0, 597) + '...' : summary
        const words = display.length

        resultText.textContent = display
        result.classList.remove('hidden')
        actions.classList.remove('hidden')
        wordCount.textContent = `约 ${words} 字`
        status.textContent = '提取式 · 不上传内容'

        try {
          localStorage.setItem(storageKey, display)
        } catch {}
      } catch (e) {
        summaryButton.classList.remove('hidden')
        status.textContent = '生成失败，请重试'
        console.error('Local summary error:', e)
      }
    }

    const cached = (() => {
      try {
        return localStorage.getItem(storageKey)
      } catch {
        return null
      }
    })()

    if (cached) {
      resultText.textContent = cached
      wordCount.textContent = `约 ${cached.length} 字`
      result.classList.remove('hidden')
      summaryButton.classList.add('hidden')
      actions.classList.remove('hidden')
    }

    btn.addEventListener('click', generate)
    regenerate.addEventListener('click', () => {
      try {
        localStorage.removeItem(storageKey)
      } catch {}
      generate()
    })
  }

  initPostSummary()
  document.addEventListener('astro:page-load', initPostSummary)
</script>
