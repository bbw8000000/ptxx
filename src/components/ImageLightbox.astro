---
// 图片灯箱 — 点击文章图片放大查看，带平滑过渡
---

<div
  id="lightbox"
  class="fixed inset-0 z-[200] flex items-center justify-center cursor-zoom-out"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="图片预览"
>
  <img
    id="lightbox-img"
    class="max-w-[90vw] max-h-[90vh] rounded-lg shadow-2xl object-contain"
    alt=""
  />
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-6 right-6 text-white/50 hover:text-white transition-all duration-300 hover:scale-110"
    aria-label="关闭图片预览"
  >
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    window.__lightboxCleanup?.()
    const controller = new AbortController()
    let previousFocus = null
    const lightbox = document.getElementById('lightbox')
    const lightboxImg = document.getElementById('lightbox-img')
    const closeBtn = document.getElementById('lightbox-close')
    if (!lightbox || !lightboxImg || !closeBtn) return
    let previousOverflow = ''

    let closeTimer = 0

    function open(src, alt) {
      window.clearTimeout(closeTimer)
      previousFocus = document.activeElement
      previousOverflow = document.body.style.overflow
      lightboxImg.src = src
      lightboxImg.alt = alt
      lightbox.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
      requestAnimationFrame(() => {
        lightbox.classList.add('is-lightbox-open')
        closeBtn.focus()
      })
    }

    function close() {
      if (!lightbox.classList.contains('is-lightbox-open')) return
      lightbox.classList.remove('is-lightbox-open')
      lightbox.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = previousOverflow
      previousFocus?.focus()
      previousFocus = null
      window.clearTimeout(closeTimer)
      closeTimer = window.setTimeout(() => {
        lightboxImg.removeAttribute('src')
      }, 540)
    }

    document.querySelectorAll('.prose img').forEach((img) => {
      img.style.cursor = 'zoom-in'
      img.setAttribute('tabindex', '0')
      img.setAttribute('role', 'button')
      img.setAttribute('aria-label', img.alt ? '放大图片：' + img.alt : '放大图片')
      img.addEventListener('click', () => open(img.src, img.alt), { signal: controller.signal })
      img.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault()
            open(img.src, img.alt)
          }
        },
        { signal: controller.signal },
      )
    })

    lightbox.addEventListener(
      'click',
      (e) => {
        if (e.target === lightbox) close()
      },
      { signal: controller.signal },
    )
    closeBtn.addEventListener('click', close, { signal: controller.signal })

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && lightbox.classList.contains('is-lightbox-open')) close()
        if (e.key === 'Tab' && lightbox.classList.contains('is-lightbox-open')) {
          e.preventDefault()
          closeBtn.focus()
        }
      },
      { signal: controller.signal },
    )
    window.__lightboxCleanup = () => {
      window.clearTimeout(closeTimer)
      lightbox.classList.remove('is-lightbox-open')
      lightbox.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = previousOverflow
      controller.abort()
    }
  })
</script>

<style>
  #lightbox {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: rgba(0, 0, 0, 0);
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
    transition:
      opacity var(--motion-base) var(--ease-standard),
      background-color var(--motion-base) var(--ease-standard),
      backdrop-filter var(--motion-slow) var(--ease-emphasized),
      visibility 0s linear var(--motion-slow);
  }

  #lightbox.is-lightbox-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    background: rgba(0, 0, 0, 0.76);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition-delay: 0s;
  }

  #lightbox-img {
    opacity: 0;
    transform: translateY(0.6rem) scale(0.94);
    filter: saturate(0.84);
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-slow) var(--ease-spring),
      filter var(--motion-base) var(--ease-standard);
  }

  #lightbox.is-lightbox-open #lightbox-img {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: saturate(1);
  }

  #lightbox-close {
    opacity: 0;
    transform: translateY(-0.35rem) scale(0.82);
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-base) var(--ease-spring);
  }

  #lightbox.is-lightbox-open #lightbox-close {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    #lightbox,
    #lightbox-img,
    #lightbox-close {
      transition: none;
    }
  }
</style>
