---
interface Props {
  tags: string[]
  activeTag?: string
}

const { tags, activeTag } = Astro.props
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag) => (
    <a
      href={`${import.meta.env.BASE_URL}tag/${tag}/`}
      class:list={[
        'px-3 py-1.5 text-sm font-medium transition-all duration-500 rounded-md',
        'font-serif',
        activeTag === tag
          ? 'bg-accent/20 text-accent border border-accent/30'
          : 'text-text-secondary bg-surface/30 backdrop-blur-sm border border-white/[0.04] hover:text-text hover:border-white/[0.10] hover:-translate-y-0.5',
      ]}
      style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1)"
    >
      {tag}
    </a>
  ))}
</div>
