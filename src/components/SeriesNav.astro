---
interface SeriesItem {
  title: string
  slug: string
  part: number
}

interface Props {
  seriesName: string
  items: SeriesItem[]
  currentSlug: string
}

const { seriesName, items, currentSlug } = Astro.props
const sorted = items.sort((a, b) => a.part - b.part)
const currentIndex = sorted.findIndex((i) => i.slug === currentSlug)
---

<div class="my-8 p-5 rounded-xl border border-accent/30 dark:border-dark-accent/30 bg-accent/5 dark:bg-dark-accent/5 shadow-sm">
  <div class="flex items-center gap-2 mb-3">
    <svg
      class="w-5 h-5 text-accent dark:text-dark-accent"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
      />
    </svg>
    <span class="text-sm font-display font-bold text-accent dark:text-dark-accent">
      {seriesName}
    </span>
    <span class="text-xs text-text-muted dark:text-dark-text-muted font-sans ml-auto">
      {currentIndex + 1} / {sorted.length}
    </span>
  </div>
  <div class="flex flex-wrap gap-2">
    {sorted.map((item) => (
      <a
        href={`${import.meta.env.BASE_URL}blog/${item.slug}/`}
        class:list={[
          'px-3 py-1.5 text-xs font-sans border rounded-lg transition-all duration-200',
          item.slug === currentSlug
            ? 'bg-accent dark:bg-dark-accent text-white border-accent dark:border-dark-accent font-medium shadow-sm shadow-accent/20 dark:shadow-dark-accent/20'
            : 'border-border/60 dark:border-dark-border/60 text-text-muted dark:text-dark-text-muted hover:border-accent/60 dark:hover:border-dark-accent/60 hover:text-accent dark:hover:text-dark-accent hover:shadow-sm',
        ]}
      >
        #{item.part} {item.title.replace(/.*#\d+：?/, '').replace(/.*#\d+\s*/, '')}
      </a>
    ))}
  </div>
</div>
