---
// 评论组件 — Firestore 实时评论，需登录
---

<div class="mt-10">
  <div class="flex items-end gap-4 mb-8 border-b border-border/40 dark:border-dark-border/40 pb-4">
    <h3 class="font-display text-xl font-bold text-text dark:text-dark-text">留言</h3>
    <p
      id="comment-count"
      class="text-xs text-text-muted dark:text-dark-text-muted ml-auto font-sans"
    ></p>
  </div>

  <!-- 未登录提示 -->
  <div
    id="comment-auth-prompt"
    class="mb-10 text-center py-8 border border-dashed border-border/40 dark:border-dark-border/40 rounded-xl"
  >
    <svg
      class="w-10 h-10 mx-auto mb-3 text-text-muted dark:text-dark-text-muted"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
      />
    </svg>
    <p id="comment-auth-title" class="text-sm text-text-muted dark:text-dark-text-muted mb-3">
      登录后即可留言
    </p>
    <form id="comment-auth-form" class="mx-auto max-w-sm space-y-3 text-left" novalidate>
      <label for="comment-auth-email" class="sr-only">
        邮箱
      </label>
      <input
        id="comment-auth-email"
        class="comment-input px-4 py-3 rounded-xl text-sm w-full"
        type="email"
        name="email"
        autocomplete="email"
        placeholder="邮箱"
        required
      />
      <label for="comment-auth-password" class="sr-only">
        密码
      </label>
      <input
        id="comment-auth-password"
        class="comment-input px-4 py-3 rounded-xl text-sm w-full"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="密码（至少 12 位）"
        required
      />
      <label for="comment-auth-name" class="sr-only">
        昵称
      </label>
      <input
        id="comment-auth-name"
        class="comment-input px-4 py-3 rounded-xl text-sm w-full hidden"
        type="text"
        name="displayName"
        maxlength="200"
        placeholder="昵称（注册时填写）"
      />
      <div class="flex justify-center gap-3">
        <button
          type="submit"
          id="comment-auth-submit"
          class="comment-submit px-6 py-2.5 rounded-xl text-sm font-medium cursor-pointer transition-all duration-300"
        >
          登录
        </button>
        <button
          type="button"
          id="comment-auth-toggle"
          class="px-4 py-2.5 text-sm rounded-xl bg-surface-alt dark:bg-dark-surface-alt text-text dark:text-dark-text hover:bg-accent/10 dark:hover:bg-dark-accent/10 transition-colors cursor-pointer"
        >
          注册新账号
        </button>
      </div>
    </form>
    <p
      id="comment-auth-status"
      class="mt-3 text-sm text-red-500 hidden"
      role="status"
      aria-live="polite"
    ></p>
  </div>

  <!-- 修改密码：默认折叠。改完会踢掉其他设备上的登录。 -->
  <form
    id="comment-password-form"
    class="hidden mb-4 p-4 space-y-3 rounded-xl border border-border/40 dark:border-dark-border/40"
    novalidate
  >
    <label for="comment-password-current" class="sr-only">
      当前密码
    </label>
    <input
      id="comment-password-current"
      class="comment-input px-4 py-3 rounded-xl text-sm w-full"
      type="password"
      autocomplete="current-password"
      placeholder="当前密码"
      required
    />
    <label for="comment-password-new" class="sr-only">
      新密码
    </label>
    <input
      id="comment-password-new"
      class="comment-input px-4 py-3 rounded-xl text-sm w-full"
      type="password"
      autocomplete="new-password"
      placeholder="新密码（至少 12 字节）"
      required
    />
    <div class="flex flex-wrap items-center gap-3">
      <button
        type="submit"
        id="comment-password-submit"
        class="comment-submit px-5 py-2 rounded-xl text-sm font-medium cursor-pointer transition-all duration-300"
      >
        确认修改
      </button>
      <p
        id="comment-password-status"
        class="text-xs text-text-muted dark:text-dark-text-muted font-sans"
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </form>

  <!-- 已登录：留言表单 -->
  <form id="comment-form" class="mb-10 space-y-4 hidden">
    <div class="flex items-center gap-3 mb-2">
      <img id="comment-user-avatar" class="w-8 h-8 rounded-full" src="" alt="当前登录用户头像" />
      <span id="comment-user-name" class="text-sm font-medium text-text dark:text-dark-text"></span>
      <div class="ml-auto flex items-center gap-3">
        <button
          type="button"
          id="comment-password-toggle"
          class="text-xs text-text-muted dark:text-dark-text-muted hover:text-accent dark:hover:text-dark-accent transition-colors cursor-pointer"
        >
          修改密码
        </button>
        <button
          type="button"
          id="comment-logout"
          class="text-xs text-text-muted dark:text-dark-text-muted hover:text-accent dark:hover:text-dark-accent transition-colors cursor-pointer"
        >
          退出
        </button>
      </div>
    </div>

    <label for="comment-content" class="sr-only">
      留言内容
    </label>
    <textarea
      id="comment-content"
      placeholder="说点什么..."
      required
      maxlength="2000"
      rows="4"
      class="comment-input px-4 py-3 rounded-xl text-sm w-full resize-y"
    ></textarea>
    <div class="flex items-center justify-between">
      <p
        id="comment-submit-status"
        class="text-xs text-text-muted dark:text-dark-text-muted font-sans"
        role="status"
        aria-live="polite"
      >
        评论提交后会先进入审核
      </p>
      <button
        type="submit"
        id="comment-submit-btn"
        class="comment-submit px-6 py-2.5 rounded-xl text-sm font-sans font-medium cursor-pointer transition-all duration-300 hover:shadow-lg hover:shadow-accent/20 dark:hover:shadow-dark-accent/20"
      >
        发送
      </button>
    </div>
  </form>

  <!-- 评论列表 -->
  <div id="comment-list" class="space-y-6">
    <p class="comment-empty">加载中...</p>
  </div>
</div>

<style>
  .comment-input {
    font-family: var(--font-sans);
    background: var(--color-surface-alt);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }
  .comment-input::placeholder {
    color: var(--color-text-muted);
  }
  .comment-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  :root.dark .comment-input {
    background: var(--color-dark-surface-alt);
    color: var(--color-dark-text);
    border-color: var(--color-dark-border);
  }
  :root.dark .comment-input::placeholder {
    color: var(--color-dark-text-muted);
  }
  :root.dark .comment-input:focus {
    border-color: var(--color-dark-accent);
  }

  .comment-submit {
    background: var(--color-accent);
    color: white;
  }
  .comment-submit:hover {
    opacity: 0.85;
  }
  :root.dark .comment-submit {
    background: var(--color-dark-accent);
    color: var(--color-dark-surface);
  }

  .comment-item {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  :root.dark .comment-item {
    border-bottom-color: var(--color-dark-border);
  }
  .comment-item:last-child {
    border-bottom: none;
  }
  .comment-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .comment-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .comment-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .comment-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-sans);
  }
  :root.dark .comment-avatar-fallback {
    background: var(--color-dark-accent);
    color: var(--color-dark-surface);
  }
  .comment-author {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  :root.dark .comment-author {
    color: var(--color-dark-text);
  }
  .comment-time {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  :root.dark .comment-time {
    color: var(--color-dark-text-muted);
  }
  .comment-body {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    padding-left: 2.75rem;
  }
  :root.dark .comment-body {
    color: var(--color-dark-text);
  }
  .comment-delete {
    padding-left: 2.75rem;
    margin-top: 0.25rem;
  }
  .comment-delete button {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.2s;
  }
  .comment-delete button:hover {
    color: #ef4444;
  }

  .comment-empty {
    text-align: center;
    padding: 2rem 0;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
  }
  :root.dark .comment-empty {
    color: var(--color-dark-text-muted);
  }
  .comment-retry {
    min-height: 2.75rem;
    margin-top: 0.75rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border-glass-strong);
    border-radius: 0.5rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .comment-retry:hover,
  .comment-retry:focus-visible {
    color: var(--color-text);
    border-color: var(--border-warm);
    outline: none;
  }
</style>

<script>
  import {
    isFirebaseConfigured,
    onAuth,
    login,
    register,
    logout,
    subscribeComments,
    createComment,
    deleteComment,
    changePassword,
    type Comment,
    type User,
  } from '../lib/api'
  import { CONTENT_MAX_BYTES, PASSWORD_MIN_BYTES, utf8Length } from '../utils/textLimits'
  import { escapeHtml, safeImageUrl } from '../lib/dom'

  declare global {
    interface Window {
      __commentCleanup?: () => void
    }
  }

  let pageId = window.location.pathname
  let currentUser: User | null = null
  let unsubscribe: (() => void) | null = null
  let authUnsubscribe: (() => void) | null = null

  function formatCommentTime(ts: Comment['createdAt']) {
    if (!ts) return ''
    const d = ts.toDate()
    return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  }

  function renderComments(list: HTMLElement, comments: Comment[]) {
    const count = document.getElementById('comment-count')
    if (count) count.textContent = comments.length > 0 ? `${comments.length} 条留言` : ''

    if (comments.length === 0) {
      list.innerHTML = '<p class="comment-empty">还没有留言，来做第一个吧</p>'
      return
    }

    list.innerHTML = comments
      .map((c) => {
        const photoURL = safeImageUrl(c.photoURL)
        const avatarHtml = photoURL
          ? `<img src="${escapeHtml(photoURL)}" alt="${escapeHtml(c.displayName)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" />`
          : `<div class="comment-avatar-fallback">${escapeHtml(c.displayName).charAt(0).toUpperCase()}</div>`
        const deleteBtn =
          currentUser && currentUser.uid === c.uid
            ? `<div class="comment-delete"><button data-id="${escapeHtml(c.id)}">删除</button></div>`
            : ''
        return `
        <div class="comment-item">
          <div class="comment-meta">
            <div class="comment-avatar">${avatarHtml}</div>
            <span class="comment-author">${escapeHtml(c.displayName)}</span>
            <span class="comment-time">${formatCommentTime(c.createdAt)}</span>
          </div>
          <div class="comment-body">${escapeHtml(c.content).replace(/\n/g, '<br>')}</div>
          ${deleteBtn}
        </div>
      `
      })
      .join('')

    // 删除按钮事件
    list.querySelectorAll('.comment-delete button').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')
        if (!id || !confirm('确定删除这条评论？')) return
        try {
          await deleteComment(id)
        } catch (error) {
          console.error('Failed to delete comment:', error)
          alert(error instanceof Error ? error.message : '删除失败，请重试')
        }
      })
    })
  }

  function loadComments(list: HTMLElement) {
    if (unsubscribe) unsubscribe()
    unsubscribe = subscribeComments(
      pageId,
      (comments) => renderComments(list, comments),
      (error) => {
        console.error('Comments load error:', error)
        list.innerHTML =
          '<div class="comment-empty">' +
          '<p>留言暂时没有加载出来</p>' +
          '<button id="comment-retry" class="comment-retry" type="button">重新加载</button>' +
          '</div>'
        document
          .getElementById('comment-retry')
          ?.addEventListener('click', () => loadComments(list), { once: true })
      },
    )
  }

  document.addEventListener('astro:page-load', () => {
    window.__commentCleanup?.()
    const controller = new AbortController()
    pageId = window.location.pathname
    authUnsubscribe?.()
    authUnsubscribe = null
    const form = document.getElementById('comment-form')
    const list = document.getElementById('comment-list')
    const authPrompt = document.getElementById('comment-auth-prompt')
    const userAvatar = document.getElementById('comment-user-avatar') as HTMLImageElement | null
    const userName = document.getElementById('comment-user-name')
    const submitStatus = document.getElementById('comment-submit-status')
    const authStatus = document.getElementById('comment-auth-status')

    if (!form || !list) return
    const setAuthStatus = (message: string) => {
      if (!authStatus) return
      authStatus.textContent = message
      authStatus.classList.toggle('hidden', !message)
    }
    if (!isFirebaseConfigured) {
      authPrompt?.classList.add('hidden')
      list.innerHTML = '<p class="comment-empty" role="status">留言功能暂未配置</p>'
      return
    }

    // 邮箱 + 密码：同一套表单在「登录」和「注册」之间切换
    let authMode: 'login' | 'register' = 'login'
    const authForm = document.getElementById('comment-auth-form') as HTMLFormElement | null
    const authEmail = document.getElementById('comment-auth-email') as HTMLInputElement | null
    const authPassword = document.getElementById('comment-auth-password') as HTMLInputElement | null
    const authName = document.getElementById('comment-auth-name') as HTMLInputElement | null
    const authSubmit = document.getElementById('comment-auth-submit')
    const authToggle = document.getElementById('comment-auth-toggle')
    const authTitle = document.getElementById('comment-auth-title')

    const applyAuthMode = (next: 'login' | 'register') => {
      authMode = next
      const isRegister = next === 'register'
      authName?.classList.toggle('hidden', !isRegister)
      if (authName) authName.required = isRegister
      if (authTitle) authTitle.textContent = isRegister ? '注册后即可留言' : '登录后即可留言'
      if (authSubmit) authSubmit.textContent = isRegister ? '注册并登录' : '登录'
      if (authToggle) authToggle.textContent = isRegister ? '已有账号？去登录' : '注册新账号'
      if (authPassword) authPassword.autocomplete = isRegister ? 'new-password' : 'current-password'
      setAuthStatus('')
    }
    applyAuthMode('login')

    authToggle?.addEventListener(
      'click',
      () => {
        applyAuthMode(authMode === 'login' ? 'register' : 'login')
      },
      { signal: controller.signal },
    )

    authForm?.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault()
        const email = authEmail?.value.trim() || ''
        const password = authPassword?.value || ''
        const displayName = authName?.value.trim() || ''

        if (!email || !password) {
          setAuthStatus('请填写邮箱和密码')
          return
        }
        // 按字节判断，与后端 cleanPassword 一致。用 .length 会把「4 个汉字」
        // 这类已达标的密码判为过短，导致注册能过、登录却被前端拦住。
        if (utf8Length(password) < PASSWORD_MIN_BYTES) {
          setAuthStatus(`密码至少 ${PASSWORD_MIN_BYTES} 字节（汉字按 3 字节计）`)
          return
        }
        if (authMode === 'register' && !displayName) {
          setAuthStatus('请填写昵称')
          return
        }

        const label = authMode === 'register' ? '注册并登录' : '登录'
        if (authSubmit) {
          authSubmit.setAttribute('disabled', 'disabled')
          authSubmit.textContent = authMode === 'register' ? '注册中...' : '登录中...'
        }
        try {
          setAuthStatus('')
          if (authMode === 'register') await register(email, password, displayName)
          else await login(email, password)
          authForm.reset()
        } catch (error) {
          setAuthStatus(error instanceof Error ? error.message : '操作失败，请重试')
        } finally {
          if (authSubmit) {
            authSubmit.removeAttribute('disabled')
            authSubmit.textContent = label
          }
        }
      },
      { signal: controller.signal },
    )

    document.getElementById('comment-logout')?.addEventListener(
      'click',
      async () => {
        try {
          await logout()
        } catch (error) {
          console.error('Logout failed:', error)
        }
      },
      { signal: controller.signal },
    )

    // 修改密码
    const passwordForm = document.getElementById('comment-password-form') as HTMLFormElement | null
    const passwordCurrent = document.getElementById(
      'comment-password-current',
    ) as HTMLInputElement | null
    const passwordNew = document.getElementById('comment-password-new') as HTMLInputElement | null
    const passwordSubmit = document.getElementById(
      'comment-password-submit',
    ) as HTMLButtonElement | null
    const passwordStatus = document.getElementById('comment-password-status')

    const setPasswordStatus = (message: string, isError = false) => {
      if (!passwordStatus) return
      passwordStatus.textContent = message
      passwordStatus.classList.toggle('text-red-500', isError)
    }

    document.getElementById('comment-password-toggle')?.addEventListener(
      'click',
      () => {
        passwordForm?.classList.toggle('hidden')
        setPasswordStatus('')
      },
      { signal: controller.signal },
    )

    passwordForm?.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault()
        const current = passwordCurrent?.value || ''
        const next = passwordNew?.value || ''
        if (!current || !next) {
          setPasswordStatus('请填写当前密码和新密码', true)
          return
        }
        if (utf8Length(next) < PASSWORD_MIN_BYTES) {
          setPasswordStatus(`新密码至少 ${PASSWORD_MIN_BYTES} 字节（汉字按 3 字节计）`, true)
          return
        }
        if (passwordSubmit) {
          passwordSubmit.disabled = true
          passwordSubmit.textContent = '提交中...'
        }
        try {
          const { revoked } = await changePassword(current, next)
          passwordForm.reset()
          setPasswordStatus(
            revoked > 0 ? `已修改，其他 ${revoked} 台设备的登录已退出` : '已修改密码',
          )
        } catch (error) {
          setPasswordStatus(error instanceof Error ? error.message : '修改失败，请重试', true)
        } finally {
          if (passwordSubmit) {
            passwordSubmit.disabled = false
            passwordSubmit.textContent = '确认修改'
          }
        }
      },
      { signal: controller.signal },
    )

    // 实时字节计数。汉字在 .length 里算 1、按字节算 3，不提前提示的话
    // 用户会以为能发出去，然后被后端 400 拒掉。
    const contentInput = document.getElementById('comment-content') as HTMLTextAreaElement | null
    const defaultSubmitHint = '评论提交后会先进入审核'
    contentInput?.addEventListener(
      'input',
      () => {
        if (!submitStatus) return
        const bytes = utf8Length(contentInput.value.trim())
        submitStatus.textContent =
          bytes > CONTENT_MAX_BYTES
            ? `内容太长：${bytes} / ${CONTENT_MAX_BYTES} 字节`
            : defaultSubmitHint
      },
      { signal: controller.signal },
    )

    // 认证状态
    authUnsubscribe = onAuth((user) => {
      currentUser = user
      if (user) {
        form.classList.remove('hidden')
        authPrompt?.classList.add('hidden')
        const avatarUrl = safeImageUrl(user.photoURL)
        if (userAvatar) {
          userAvatar.src = avatarUrl
          userAvatar.classList.toggle('hidden', !avatarUrl)
        }
        if (userName) userName.textContent = user.displayName || user.email || '用户'
        setAuthStatus('')
      } else {
        form.classList.add('hidden')
        authPrompt?.classList.remove('hidden')
        passwordForm?.classList.add('hidden')
        passwordForm?.reset()
        setPasswordStatus('')
      }
      loadComments(list)
    })

    // 提交评论
    form.addEventListener(
      'submit',
      async (e) => {
        e.preventDefault()
        if (!currentUser) return
        const textarea = document.getElementById('comment-content') as HTMLTextAreaElement | null
        // 不再静默 slice(0, 2000)：一是按字符截断与后端的字节口径不一致，
        // 二是截断会悄悄丢掉用户已经写下的内容。超限就明确报错。
        const content = textarea?.value.trim() ?? ''
        if (!content) return
        const contentBytes = utf8Length(content)
        if (contentBytes > CONTENT_MAX_BYTES) {
          if (submitStatus) {
            submitStatus.textContent = `内容太长：${contentBytes} / ${CONTENT_MAX_BYTES} 字节，请精简后再发送`
          }
          return
        }
        const submitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null
        if (submitBtn) {
          submitBtn.disabled = true
          submitBtn.textContent = '正在提交...'
        }

        try {
          if (submitStatus) submitStatus.textContent = '正在提交...'
          await createComment({ pageId, content })
          if (textarea) textarea.value = ''
          if (submitStatus) submitStatus.textContent = '已提交，审核通过后会显示'
        } catch (error) {
          console.error('Failed to post comment:', error)
          if (submitStatus) {
            submitStatus.textContent = error instanceof Error ? error.message : '提交失败，请重试'
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false
            submitBtn.textContent = '发送'
          }
        }
      },
      { signal: controller.signal },
    )
    window.__commentCleanup = () => {
      controller.abort()
      authUnsubscribe?.()
      authUnsubscribe = null
      unsubscribe?.()
      unsubscribe = null
      currentUser = null
    }
  })
  document.addEventListener('astro:before-swap', () => window.__commentCleanup?.())
</script>
